b.jpg","source":"original","mtime":"1541663305","size":"16831","md5":"5f27bc09183204841272b232da055af8","crc32":"7af23d65","sha1":"35c459eac9587e3b7c0b7e7f6a9623b2d1b1109b","format":"Item Tile","rotation":"0"}],"files_count":21,"item_last_updated":1541663318,"item_size":1720799445,"metadata":{"identifier":"Bud_Powell_Tape_5_1958-1960","date":"1960","description":"From the David W. Niven Collection of Jazz History, a cassette recording from the Jazz artist Bud Powell, from the era of 1958-1960. Tape 5. <p>Recorded with a TEAC AD-500 cassette deck, a desktop computer with a modern SoundBlaster sound card, and the audio recording program GoldWave.  Each cassette was recorded to a single WAV-format file at 44100 kHz, 16-bit quality, to match the quality of CD-audio. Each resulting WAV file was split at the division between Side A and Side B of the cassette, in order to make it possible for each WAV file to fit on a single 80-minute CD.</p>","language":"eng","mediatype":"audio","title":"Niven Jazz Collection: Bud Powell Tape 5 (1958-1960)","collection":"davidwnivenjazz","publicdate":"2013-05-29 00:51:29","uploader":"jscott@archive.org","addeddate":"2013-05-29 00:51:29","boxid":"OL100020605","backup_location":"ia905701_15"},"server":"ia601905.us.archive.org","uniq":713262482,"workable_servers":["ia601905.us.archive.org","ia801905.us.archive.org"]}