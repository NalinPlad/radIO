_radiopapesse-dani_gal_achim_lengerer.mp3","mtime":"1493876043","size":"12032","md5":"347ceb04f9c29df38c195d039c1d6179","crc32":"7d8fa4bc","sha1":"f1588b4cc8f2581f0630afb4bb70d858c33dd1ec"},{"name":"radia_s28_n370_radiopapesse-dani_gal_achim_lengerer_archive.torrent","source":"metadata","btih":"7cab4ccd4b826ae87f55e7d68705726571d43ef1","mtime":"1537048660","size":"5669","md5":"fbdefebc26103c7160fc1f0e25ab1d3f","crc32":"2538a4ff","sha1":"e81d90c3f12d5a979e60fe4c3e9c22b29b9ebe0c","format":"Archive BitTorrent"},{"name":"radia_s28_n370_radiopapesse-dani_gal_achim_lengerer_files.xml","source":"original","format":"Metadata","md5":"ff429ccf8b5986ee191e4099c47f9a28","summation":"md5"},{"name":"radia_s28_n370_radiopapesse-dani_gal_achim_lengerer_meta.sqlite","source":"original","mtime":"1493875902","size":"19456","format":"Metadata","md5":"3c0f3089bd87b925ceda3895d82c22df","crc32":"801be263","sha1":"0c8f3c51e364c3ce112a231c6b947800aa31a28e"},{"name":"radia_s28_n370_radiopapesse-dani_gal_achim_lengerer_meta.xml","source":"original","mtime":"1732431999","size":"2093","format":"Metadata","md5":"602e25500b51cc17afd783ee469d4bf6","crc32":"659723cb","sha1":"7318b626ca43bca0a2608c633ac5d08e98360a32"}],"files_count":11,"item_last_updated":1732431999,"item_size":65891301,"metadata":{"identifier":"radia_s28_n370_radiopapesse-dani_gal_achim_lengerer","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"<div class=\"entry-content\">\n\t\t\t\t\t\t<p>British Artist William Furlong began a project of mapping the \nterritory of contemporary art in a series of cassette editions. The \nAudio Arts project is a massive archive of intervies wirg artists \nranging from Joseph Beuys to Tracey Emin, but also contains documents of\n world exibitions, symposia, festivals and many original acoustic works \nby artists. Furlong finds rgar his way of working – using sounds and \nvoice as materials – is a sculptural and creative process. It arose from\n his intimate association with the recorded voice.<br />\nIn 2007 artists Achim Lengerer and Dani Gal visited Furlong in his Audio\n Arts studio and recorded this sound piece as a reference to his body of\n work.</p>\n<p>This Radia show is a special edit of Lengerer and Gal’s piece \nrealized in 2007 for their project VOICEOVERHEAD. “Voiceoverhead” dealt \nwith performative aspects of speech, sound documents and archived spoken\n language.</p>\n<p>Any resemblance with Radia show 228 by radio x is accidental but undeniable.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"28","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Radio Papesse","title":"Show 0370: what you doin’ tapin (radia edit) by Dani Gal & Achim Lengerer (Radio Papesse)","publicdate":"2017-05-04 05:29:32","uploader":"radia.fm@gmail.com","addeddate":"2017-05-04 05:29:32","date":"2012-04-30","creator":"Radio Papesse","backup_location":"ia906403_17","collection_added":"radiostationarchives"},"server":"ia600701.us.archive.org","uniq":2088280890,"workable_servers":["ia600701.us.archive.org","ia800701.us.archive.org"]}