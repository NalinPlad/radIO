n387_radiozero_Latesummer_Night's_Dream.mp3","mtime":"1494028308","size":"358936","md5":"438e983c94eded68772e5f54c3b41427","crc32":"c83d7def","sha1":"a23adbb00ce9c781c9b202b2f8976684d9a970b7"},{"name":"radia_s29_n387_radiozero_Latesummer_Night's_Dream.mp3","source":"original","mtime":"1494028168","size":"67181961","md5":"de4ac3fc3260e841657b7a7e1ea5f4d9","crc32":"3ee7462e","sha1":"c566be59e26e128b8d3f877adfa9136777762a7f","format":"VBR MP3","length":"1679.5","height":"0","width":"0","title":"radia_201208","external-identifier":"urn:acoustid:04408a80-5e6a-4839-84a0-6303179d9f49","external-identifier-match-date":"acoustid:2019-03-26T12:59:48Z"},{"name":"radia_s29_n387_radiozero_Latesummer_Night's_Dream.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s29_n387_radiozero_Latesummer_Night's_Dream.mp3","mtime":"1494028240","size":"19685091","md5":"ba2c6c12741d96ae2e7610e77f9e0447","crc32":"efe52a83","sha1":"38ca0d326da608c7b4716b6b2b3fff8198693067","length":"1679.5","height":"0","width":"0"},{"name":"radia_s29_n387_radiozero_Latesummer_Night's_Dream.png","source":"derivative","format":"PNG","original":"radia_s29_n387_radiozero_Latesummer_Night's_Dream.mp3","mtime":"1494028282","size":"9843","md5":"11f79505f025a50340df8b870f7f7880","crc32":"6caf4977","sha1":"33d12ffe87bfbcf1ceb73455d9849187b3ac66e9"}],"files_count":11,"item_last_updated":1665836072,"item_size":87282284,"metadata":{"identifier":"Radia_s29_n387_radiozero_Latesummer_Nights_Dream","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"<div class=\"entry-content\">\n\t\t\t\t\t\t<p><a href=\"http://www.radia.fm/wp-content/uploads/2012/08/0013-jovino2.jpg\" rel=\"nofollow\"><img class=\"alignnone size-full wp-image-2015\" title=\"0013-jovino\" src=\"//web.archive.org/web/2im_/http://www.radia.fm/wp-content/uploads/2012/08/0013-jovino2.jpg\" alt=\"\" height=\"563\" width=\"750\" /></a>The\n perfect timing for shell hunting is immediately before and after low \ntide. At this timing,  clandestine shell hunters suddenly come from the \ndunes and cross the low waters on foot. The small boats are stranded in \nthe sand gently moving with the wind and soft south currents. The shell \nworkers are now not only fisherman or related, but also people that have\n other activities or jobs, even lawyers, and they spend hours on the \nwater to get 3 to 8 kg of clams to make a living.</p>\n<p>This collected field-recordings from and near the sand banks are \nedited and overlap different places where the shell hunting persists as a\n clandestine way of life.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"29","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Rádio Zero","title":"Show 0387: Latesummer_Night’s_Dream (diving for pearls) by Paulo Raposo (Rádio Zero)","publicdate":"2017-05-05 23:48:36","uploader":"radia.fm@gmail.com","addeddate":"2017-05-05 23:48:36","date":"2012-08-27","creator":"Rádio Zero","backup_location":"ia906403_21","external_metadata_update":"2019-03-26T12:59:48Z"},"server":"ia601505.us.archive.org","uniq":672196414,"workable_servers":["ia601505.us.archive.org","ia801505.us.archive.org"]}