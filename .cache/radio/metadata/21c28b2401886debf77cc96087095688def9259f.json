2238a5b9536c3a70235e270723b7738"},{"name":"radia_s24_n287_Resonance_youreonnext_tomwallace.mp3","source":"original","size":"40321768","format":"VBR MP3","title":"You're on Next","creator":"Tom Wallace","album":"Radia Season 24","track":"287","mtime":"1286209377","md5":"f8f3a73fab79921a0de99ca2df8b2fbd","crc32":"faab2f07","sha1":"58837cd8e62fe5ac2a652a910b549b7ec495f7a8","length":"1680.04","height":"0","width":"0","external-identifier-match-date":"acoustid:2019-04-04T16:48:02Z","external-identifier":"urn:acoustid:c016682a-e645-4896-9ea5-969b98ea68e1"},{"name":"radia_s24_n287_Resonance_youreonnext_tomwallace.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s24_n287_Resonance_youreonnext_tomwallace.mp3","mtime":"1492336347","size":"18156158","md5":"3ba7e31f2edf4bb33741083519d596ee","crc32":"ac879288","sha1":"27c61985cbb235a99803720d9f95c58a3274df25","length":"1680","height":"0","width":"0"},{"name":"radia_s24_n287_Resonance_youreonnext_tomwallace.png","source":"derivative","format":"PNG","original":"radia_s24_n287_Resonance_youreonnext_tomwallace.mp3","mtime":"1492336386","size":"11744","md5":"cc2d86c01e91fcd018ffbbe5ec90273f","crc32":"eae15248","sha1":"187af095264151cd10383f3bb5957a94aac4a0ec"}],"files_count":11,"item_last_updated":1709922672,"item_size":58795105,"metadata":{"identifier":"RadiaSeason024287","title":"Show 0287: You’re on Next by Tom Wallace (Resonance FM)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 287 of season 24 of the <a href=\"http://www.radia.fm\" rel=\"nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://resonancefm.com\" rel=\"nofollow\">Resonance 104.4 FM</a>. \n\nIt was broadcasted in all Radia stations in the week between 27.09.2010 and 03.10.2010. \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"nofollow\">Read about Radia on wikipedia.</a>\n\n--\n\n<b>\"You're on Next\"    </b><br /><br />\n\nInterviews with DJs from the London free party scene. Produced by Tom Wallace.<br /><br />\n\nThis piece explores the experiences of six DJs who have all been involved in the vibrant free party scene in the 1990s. The interviews explore how they got involved in the scene, how they view their craft and recall the magic moments and mishaps along the way. These are set against the warped sonics of the sound systems they played on.<br /><br />\n\nFeaturing: Neil Controlled Weirdness, Gizelle, Louise +1, Rowan Megabitch, Jason Warlock and Jerome hill.","subject":"radio art;Radia;Resonance FM","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-10-04 16:24:36","addeddate":"2010-10-04 16:14:24","uploader":"radia.fm@gmail.com","updater":["Radia.fm","Radia.fm"],"updatedate":["2010-10-04 16:25:20","2010-11-05 23:25:26"],"boxid":"OL100020612","backup_location":"ia903606_22","date":"2010-09-27","year":"2010","radiaseason":"24","creator":"Resonance FM","external_metadata_update":"2019-04-04T16:48:02Z"},"server":"ia600205.us.archive.org","uniq":1999634169,"workable_servers":["ia600205.us.archive.org","ia800205.us.archive.org"]}