":"1541651148","size":"22646","md5":"8eee6c6c094270e98944f14e235151a2","crc32":"1abb13af","sha1":"f0a409d50f7575a89b121024f8b214f44f3800d6","format":"Item Tile","rotation":"0"}],"files_count":21,"item_last_updated":1541651161,"item_size":1798223270,"metadata":{"identifier":"Benny_Goodman_Tape_14_1938","date":"1938","description":"From the David W. Niven Collection of Jazz History, a cassette recording from the Jazz artist Benny Goodman, from the era of 1938. Tape 14. <p>Recorded with a TEAC AD-500 cassette deck, a desktop computer with a modern SoundBlaster sound card, and the audio recording program GoldWave.  Each cassette was recorded to a single WAV-format file at 44100 kHz, 16-bit quality, to match the quality of CD-audio. Each resulting WAV file was split at the division between Side A and Side B of the cassette, in order to make it possible for each WAV file to fit on a single 80-minute CD.</p>","language":"eng","mediatype":"audio","title":"Niven Jazz Collection: Benny Goodman Tape 14 (1938)","collection":"davidwnivenjazz","publicdate":"2013-05-28 22:41:22","uploader":"jscott@archive.org","addeddate":"2013-05-28 22:41:22","boxid":"OL100020605","backup_location":"ia905701_15"},"server":"ia803200.us.archive.org","uniq":800958516,"workable_servers":["ia803200.us.archive.org","ia903200.us.archive.org"]}