pg","mtime":"1369785030","size":"8773","md5":"10d27d352a476b71bfc9c7f6063972f5","crc32":"a96313b3","sha1":"8c5430fe6cb813a34384f0d0fc0a0d1848ca2a46"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1541648801","size":"14978","md5":"d9d2d2a4d7eccbff26dbb5a43da8d7a6","crc32":"738d5d06","sha1":"24bb60f14bd087e9b770cbaa5dec17118154b001","format":"Item Tile","rotation":"0"}],"files_count":21,"item_last_updated":1541648814,"item_size":1671048412,"metadata":{"identifier":"Benny_Goodman_Tape_8_June_6_1935","date":"1935","description":"From the David W. Niven Collection of Jazz History, a cassette recording from the Jazz artist Benny Goodman, from the era of June 6, 1935. Tape 8. <p>Recorded with a TEAC AD-500 cassette deck, a desktop computer with a modern SoundBlaster sound card, and the audio recording program GoldWave.  Each cassette was recorded to a single WAV-format file at 44100 kHz, 16-bit quality, to match the quality of CD-audio. Each resulting WAV file was split at the division between Side A and Side B of the cassette, in order to make it possible for each WAV file to fit on a single 80-minute CD.</p>","language":"eng","mediatype":"audio","title":"Niven Jazz Collection: Benny Goodman Tape 8 (June 6, 1935)","collection":"davidwnivenjazz","publicdate":"2013-05-28 23:37:22","uploader":"jscott@archive.org","addeddate":"2013-05-28 23:37:22","boxid":"OL100020605","backup_location":"ia905701_15"},"server":"ia801908.us.archive.org","uniq":1898397044,"workable_servers":["ia801908.us.archive.org","ia601908.us.archive.org"]}