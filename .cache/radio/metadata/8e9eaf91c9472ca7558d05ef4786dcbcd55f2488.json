bd4f","sha1":"d5b044bf2072f2f01ded6c89ce05c73104429d6b","format":"Metadata"},{"name":"radia_s48_n895_gasp_ronn_berglund_radioworm_spectrogram.png","source":"derivative","format":"Spectrogram","original":"radia_s48_n895_gasp_ronn_berglund_radioworm.wav","mtime":"1653563120","size":"293442","md5":"d5bafd889abde95be75c6570c3fa79de","crc32":"a1167090","sha1":"a28474dd6634e676d75dbce35a62cbbf1d42a126"}],"files_count":15,"item_last_updated":1709139062,"item_size":610864465,"metadata":{"identifier":"radia_s48_n895_gasp_ronn_berglund_radioworm","mediatype":"audio","collection":["radiafm","radiostationarchives","radioprograms"],"creator":"RadioWORM","date":"2022-05-23","description":"A rendition of what happens when you spend 6 days in Ton studio Worm <br />while the world is burning with war, post-pandemic dystopia nightmares, <br />weird santa´s and the bubbling spring-time vibes of Rotterdam. The piece <br />is an attempt to combine Christian Rønn´s freeform playing-practice on <br />keyboard-instruments (Piano, Church Organ, Rhodes &amp; Würlitzer in <br />combination with electronics) with Helena Berglund´s evocative <br />performance-poetry.  The duo releases music under the name “MäRK”, and <br />while working on this piece in Ton Studio Worm, they used  a <br />“one-take-Dogma” which involved minimal editing and post-editing, partly <br />to separate this work from their previous releases, which are all <br />intensively edited studio-productions.<br /><br />https://www.christianronn.dk<br />https://bit.ly/36jva0Y (Rønn´s music on Soundcloud)<br />https://bit.ly/3IaFuWk (MäRK on Bandcamp)<br />https://spoti.fi/3q2z2uG (MäRK on SPotify)","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","radiaseason":"48","scanner":"Internet Archive HTML5 Uploader 1.6.4","subject":"radio art;Radia;RadioWORM","title":"Show 0895: GASP by Christian Rønn & Helena Berglund (RadioWORM)","uploader":"radia.fm@gmail.com","publicdate":"2022-05-26 10:36:51","addeddate":"2022-05-26 10:36:51","year":"2022"},"server":"ia804507.us.archive.org","uniq":1911829458,"workable_servers":["ia804507.us.archive.org","ia904507.us.archive.org"]}