5289c969a90e933c521ddf33de6f90"},{"name":"radia_s24_n293_rebootfm_zen_napalm_pharohchromium.mp3","source":"original","format":"VBR MP3","mtime":"1290028655","size":"55197361","md5":"7ac7f8d8606013775cc7ba5e101b9e29","crc32":"e3263cb5","sha1":"6b907f6e582843171a419498014094cfc7de00a3","title":"Zen & Napalm","creator":"PHAROAH CHROMIUM","album":"Radia Season 24","track":"293","length":"1724.92","height":"0","width":"0","external-identifier":"urn:acoustid:0cf917b1-35ac-4c28-8a48-a3e05334712d","external-identifier-match-date":"acoustid:2019-03-21T23:22:00Z"},{"name":"radia_s24_n293_rebootfm_zen_napalm_pharohchromium.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s24_n293_rebootfm_zen_napalm_pharohchromium.mp3","mtime":"1492336403","size":"16662202","md5":"900518578c1f7a7a6edb98982c30ae07","crc32":"fecb5c29","sha1":"e22776f02b2e1b1af65b12482304c164c24d0e22","length":"1724.92","height":"0","width":"0"},{"name":"radia_s24_n293_rebootfm_zen_napalm_pharohchromium.png","source":"derivative","format":"PNG","original":"radia_s24_n293_rebootfm_zen_napalm_pharohchromium.mp3","mtime":"1492336488","size":"11233","md5":"1c20cfe15b0846ea214b173528e0acbd","crc32":"39ce8ffd","sha1":"e6448efdd4779cff6d3d353c55d9e03be67dfe02"}],"files_count":11,"item_last_updated":1708507660,"item_size":72284319,"metadata":{"identifier":"RadiaSeason24293","title":"Show 0293: Zen & Napalm by Ghazi Barakat (Reboot.fm)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 293 of season 24 of the <a href=\"http://www.radia.fm\" rel=\"nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://reboot.fm\" rel=\"nofollow\">reboot.fm</a>. \n\nIt was broadcasted in all Radia stations in the week between 08.11.2010 and 14.11.2010. \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"nofollow\">Read about Radia on wikipedia.</a>\n\n--\n\nPHAROAH CHROMIUM (mutant psych / kozmic blues / concrete jungle)\n\nNeues Projekt von Ghazi Barakat (Boy from Brazil, Assassinations, Golden Showers). Drei Sampler, viel Effekthascherei und ein wenig Schminke. Die Maschinen sollten als lebenserhaltende GerÃ¤te betrachtet werden. Eine Herz-Lungen-Maschine spielt den Soundtrack deines Lebens. Wer entscheidet, wann abgeschaltet wird?\n\nNew project from Ghazi Barakat (Boy from Brazil, Assassinations, Golden Showers). Three sampling devices, too many effects and a little make-up.Machines as life support devices. A cardiopulmonary bypass playing the soundtrack of your life. When is the time right to turn it off?","subject":"radio art;Radia;Reboot.fm","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-11-17 21:19:04","addeddate":"2010-11-17 21:16:00","uploader":"radia.fm@gmail.com","updatedate":"2010-11-17 21:20:17","updater":"Radia.fm","boxid":"OL100020613","backup_location":"ia903607_11","date":"2010-11-08","radiaseason":"24","creator":"Reboot.fm","year":"2010"},"server":"ia800201.us.archive.org","uniq":625746760,"workable_servers":["ia800201.us.archive.org","ia600201.us.archive.org"]}