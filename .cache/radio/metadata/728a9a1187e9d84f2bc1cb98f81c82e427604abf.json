51bea45e3e628","crc32":"7a8b660d","sha1":"56d54a82c08b6d1bd1266e5de132c27dbdfc4982","format":"VBR MP3","length":"1680.77","height":"0","width":"0","genre":"radio art","artist":"JD Zazie","title":"MuseRuole - Radio Edition","album":"http://reboot.fm","track":"radia Season 30 Show 430","external-identifier-match-date":"acoustid:2019-04-16T19:41:11Z","external-identifier":"urn:acoustid:e7038175-4424-480d-bf39-6eec622f2852"},{"name":"Radia_s30_n430_reboot_JD Zazie_MuseRuole.ogg","source":"derivative","format":"Ogg Vorbis","original":"Radia_s30_n430_reboot_JD Zazie_MuseRuole.mp3","mtime":"1480293035","size":"18364519","md5":"82d63074d7f35af3502a13213a4d7ded","crc32":"6b5c78ab","sha1":"e7a553126d07577b55e0513e93a3f580c7b4f42c","length":"1680.77","height":"0","width":"0"},{"name":"Radia_s30_n430_reboot_JD Zazie_MuseRuole.png","source":"derivative","format":"PNG","original":"Radia_s30_n430_reboot_JD Zazie_MuseRuole.mp3","mtime":"1480293080","size":"11387","md5":"3295be9b767fdd08c917b80cbc72d57c","crc32":"a0303c06","sha1":"5f9c3b0222b57d3c0b6d311cbde91083ee8e2b59"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1535843896","size":"4815","md5":"930895b711c8386e7d0c5940ca77284a","crc32":"135a2baa","sha1":"78647824a9e240e90f6a93fce02f90bd75bf48e6","format":"Item Tile","rotation":"0"}],"files_count":11,"item_last_updated":1594587847,"item_size":85934031,"metadata":{"identifier":"RadiaS30N430RebootJDZazieMuseRuole","mediatype":"audio","collection":["radiafm","radioprograms"],"creator":"Reboot.fm","date":"2013-06-24","description":"<h1 class=\"entry-title\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:0px;vertical-align:baseline;clear:both;font-weight:normal;font-family:DaysRegular;color:rgb(210,143,0);line-height:1.3em;font-size:21px;\">Show 430: MuseRuole Radio Edition by JD Zazie for reboot.fm Berlin</h1><div class=\"entry-meta\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:0px;vertical-align:baseline;font-family:'Helvetica Neue', Arial, Helvetica, 'Nimbus Sans L', sans-serif;color:rgb(119,119,119);font-size:12px;\"><span class=\"meta-prep meta-prep-author\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">Posted on</span> <a href=\"http://www.radia.fm/?p=2552\" title=\"11:24 am\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(119,119,119);\" rel=\"nofollow\"><span class=\"entry-date\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">2013/06/24</span></a> <span class=\"meta-sep\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">by</span> <span class=\"author vcard\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\"><a class=\"url fn n\" href=\"http://www.radia.fm/?author=32\" title=\"View all posts by reboot\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(119,119,119);\" rel=\"nofollow\">reboot</a></span></div><div class=\"entry-content\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:12px 0px 0px;vertical-align:baseline;clear:both;color:rgb(51,51,51);font-family:Georgia, 'Bitstream Charter', serif;font-size:13.8px;\"><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\"><a href=\"http://www.radia.fm/wp-content/uploads/2013/06/muserole.jpg\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\"><img class=\"size-medium wp-image-2553 alignleft\" title=\"muserole\" src=\"//web.archive.org/web/2im_/http://www.radia.fm/wp-content/uploads/2013/06/muserole-211x300.jpg\" alt=\"\" width=\"211\" height=\"300\" style=\"background:transparent;border:none;margin:10px;padding:0px;vertical-align:baseline;float:left;height:auto;\" /></a></p><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\">Festival Curator JD Zazie has compiled this selection of works by Felicity Ford, Heidrun Schramm & Stini Arn for radia.fm.</p><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\">MuseRuole is a festival dedicated to experimental music and puts contemporary female musicians and performers at its centre. It is a journey of discovery into the wide world of current musical research, looking for specifically female modes of expression, with its own grammar and personal style. This year (2013) we focus on the theme of radio as a space for musical research and a medium of technological innovation, including  notions of sending and receiving in equal measure.<br />Even today radio is an important method of communication: it remains one of the most powerful, cheapest, accessible and world spanning of media. Despite its long history and being one of the first mass media of the last century, radio has always been able to renew     itself, adapting to changing realities and remaining in step with the future. And so radio is an instrument of disseminating knowledge as well as a research space for new technologies and formats: as a global platform it offers the possibility to develop innovative networks and ways to connect.</p><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\"><a href=\"http://museruole.tumblr.com/\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">http://museruole.tumblr.com/</a></p><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\"><a href=\"http://reboot.fm/\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">http://reboot.fm</a></p><div><br /></div></div>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"30","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Reboot.fm","title":"Show 0430: MuseRuole Radio Edition by JD Zazie (Reboot.fm)","publicdate":"2016-11-28 00:28:32","uploader":"radia.fm@gmail.com","addeddate":"2016-11-28 00:28:32","backup_location":"ia906301_31","external_metadata_update":"2019-04-16T19:41:11Z"},"server":"ia903209.us.archive.org","uniq":1504609814,"workable_servers":["ia903209.us.archive.org","ia803209.us.archive.org"]}