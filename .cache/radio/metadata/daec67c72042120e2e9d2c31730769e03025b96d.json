ruxelles.flac","source":"derivative","format":"Flac","original":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles.wav","mtime":"1647951836","size":"108959272","md5":"6bb96e8de1314fb50f2c619e11e6bb22","crc32":"ebb50445","sha1":"0067a792c2746e1b2a149aaa0d31f889e6b92abb","length":"1680"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles.mp3","source":"original","mtime":"1647950825","size":"67204779","md5":"9d55a96c7c9bebf79a56a23d7afa8e5a","crc32":"01070946","sha1":"0da44c96d1f8c811dcd59f164ddc8f62a8be23b1","format":"VBR MP3","length":"1680.07","title":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles","track":"01","comment":"(iTunSMPB) 00000000 00000210 00000930 00000000046A7E40 00000000 04014D8D 00000000 00000000 00000000 00000000 00000000 00000000"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles.png","source":"derivative","format":"PNG","original":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles.wav","mtime":"1647951908","size":"35573","md5":"8f47e9708285ffed8dde816ed182c177","crc32":"701b5e84","sha1":"a75de699c69a3d499e88e2aa4510e65f5c7b3703"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles.wav","source":"original","mtime":"1647951628","size":"296352044","md5":"5757e3489f5b6c313f2b67e3b9fbc1c6","crc32":"7711de3e","sha1":"9a8df3ed3765b823ee1b2ee3ac9c6ff63cacac0c","format":"WAVE","length":"1680","track":"01"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles_archive.torrent","source":"metadata","btih":"1571f5f9f047c21fde3786e404789a2db3c010ec","mtime":"1709135368","size":"22176","md5":"fb52ff977604a26982d759a5cf668e4f","crc32":"b62a77ce","sha1":"238f36d3ea555e6d83c0014d18e6bbb224369505","format":"Archive BitTorrent"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles_files.xml","source":"original","format":"Metadata","md5":"9315b653ae5ca293677db8f77a2a4249","summation":"md5"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles_meta.sqlite","source":"original","mtime":"1647951669","size":"53248","md5":"b0715b882848a66a5204b98e1263b2cb","crc32":"cccef23c","sha1":"48e23d8edb7678930a4fb5137577dd3b535913e2","format":"Metadata"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles_meta.xml","source":"original","mtime":"1709135366","size":"3241","md5":"7669b3ff6bc765e5a23cb2747f61caa9","crc32":"51d38b35","sha1":"ed58b40dac1bbdcb196f8820c1064f229176a920","format":"Metadata"},{"name":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles_spectrogram.png","source":"derivative","format":"Spectrogram","original":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles.wav","mtime":"1647951954","size":"323478","md5":"50b3a9a60fe2cb808760896eab6bedd2","crc32":"9926a4ab","sha1":"a5056580560769c32fdc052c0025cb8bd0aa996e"}],"files_count":16,"item_last_updated":1709135368,"item_size":473283528,"metadata":{"identifier":"radia_s48_n886_Rituel_radioactif_by_RadioCampusBruxelles","mediatype":"audio","collection":["radiafm","radiostationarchives","radioprograms","radioshowarchive"],"creator":"Radio Campus","date":"2022-03-21","description":"Le <b>Rituel radioactif de désenvoûtement de la finance</b> is a radio performance halfway between a magical ritual and an act of resistance.<br /><br />It engages the metamorphosis of our relationship to capitalist power. The audience, the listeners, are invited to cut the link we have with this power to free ourselves from its hold on our lives.<br /><br />This rite of passage gives rise to a real and living collective, capable of resisting the stupefaction of disasters, and of making something new. The health, economic, social and environmental crisis has exacerbated financial imbalances, inequalities and the dysfunction of the dominant mode of production. It has underlined the way in which our rights are flouted. It has shown that what is most important, what we value most, starting with our health and that of our loved ones, is worth no more than an accounting line: apart from applause, little or nothing has been done to change the health system, and commodification continues.<br /> It is time to get rid of vertical management and austerity policies; it is time to get out of the emergency, out of the reign of experts, and to facilitate the appropriation by the population of the problems it encounters; to share our knowledge, our resources, our common actions.<br />The Radioactive Ritual of Unblinding of Finance relies on collective intelligence, opens up imaginations and gives us the power to bring forth alternatives to power and the economy. This radio piece was made on October 15th, at dusk, we unblessed ourselves from the sorcerous power of finance on our health, on the health professions.<br /><br /><div><b>By the Laboratoire sauvage de recherches expérimentales Désorceler la finance</b></div><div> With : Théo Bourgeron – Brune Campos – Aline Fares – Amandine Faugère – Maxime Lacôme – Arthur Lacomme – Camille Lamy – Vincent Matyn – Emmanuelle Nizou – Fabrice Sabatier – Emilie Siaut – Suzie Suptille</div><br />Language : French only<br /><br /><b>Curation for Radio Campus Bruxelles : Carine Demange &amp; Jonathan Frigeri</b>","language":"fre","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","radiaseason":"48","scanner":"Internet Archive HTML5 Uploader 1.6.4","subject":"radio art;Radia;Radio Campus","title":"Show 0886: \"Rituel radioactif de désenvoûtement de la finance\" by Laboratoire sauvage de recherches expérimentales Désorceler la Finance (Radio Campus)","uploader":"radia.fm@gmail.com","publicdate":"2022-03-22 12:07:24","addeddate":"2022-03-22 12:07:24","year":"2022"},"server":"ia601502.us.archive.org","uniq":332253926,"workable_servers":["ia601502.us.archive.org","ia801502.us.archive.org"]}