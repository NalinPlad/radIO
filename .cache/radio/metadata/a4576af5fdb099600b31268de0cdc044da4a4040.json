39ff90a8a0c","length":"1680.07","height":"0","width":"0"},{"name":"radia_s27_n340_grenouille_andthesuncameup_320kbit.png","source":"derivative","format":"PNG","original":"radia_s27_n340_grenouille_andthesuncameup_320kbit.mp3","mtime":"1493677843","size":"11087","md5":"b10123cc620d7e4a0a74faa38e2ac42b","crc32":"4674d4dc","sha1":"3996cf74c6aaf0a6d04937d481b9e016dedb805d"},{"name":"radia_s27_n340_grenouille_andthesuncameup_320kbit_archive.torrent","source":"metadata","btih":"673483e59d7a16c36649f6df10b091af48d1acc4","mtime":"1555392489","size":"6503","md5":"26403fa4eedfb0d38d16e0dfdc8685d3","crc32":"82e565f0","sha1":"e64c8c16468c388b6a7062cec68ba7fe7db9d37c","format":"Archive BitTorrent"},{"name":"radia_s27_n340_grenouille_andthesuncameup_320kbit_files.xml","source":"original","format":"Metadata","md5":"67575c9f95692db782ff4866e6645ad5","summation":"md5"},{"name":"radia_s27_n340_grenouille_andthesuncameup_320kbit_meta.sqlite","source":"original","mtime":"1493677722","size":"22528","format":"Metadata","md5":"5fcc077f03e8a7a8f2091a594c6b797a","crc32":"e908d25a","sha1":"8b1ce01c7af72755a6e258631b803d05c80567e6"},{"name":"radia_s27_n340_grenouille_andthesuncameup_320kbit_meta.xml","source":"original","mtime":"1668998777","size":"2731","format":"Metadata","md5":"fc0f42c4ad5a3f6e1610eb8217d00125","crc32":"de4cd0d0","sha1":"012305676a81ea44187c8572d86128b9516fa003"}],"files_count":11,"item_last_updated":1668998777,"item_size":88525140,"metadata":{"identifier":"radia_s27_n340_grenouille_andthesuncameup_320kbit","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"<p>And the sun came up is the first sound piece of a project which, \nsince 2010, focuses on the soundscape of the small Russian village of \nPaanajärvi. Isolated in the thick primary forest of oriental Karelia, \nPaanajärvi is somehow living out of the time and its inhabitants -among \nthem the latest of the disappearing Karelian culture – live a tough life\n strongly bond to their environment.</p>\n<p>In the beginning of May Paanajärvi plunges into spring. The snow \neventually melts, the river breaks free from the ice and everyday, new \nbirds arrive, new insects overrun the swamps quickly followed by \nthousands of frogs. For the inhabitants it’s time to go outdoor and \nresume their activities: preparation of the fields for the coming \ncultures, repairing and putting the row boats back to the river, fishing\n etc…</p>\n<p>This is the first of four sound pieces that will each explore one season of Paanajärvi.</p>\n<p>Since 2007 Nicolas Perret and <a href=\"http://cedric.anglaret.free.fr/\" rel=\"nofollow\">Cedric Anglaret</a>\n joined their own practices of sound, documentary and performative art \ninto a common project of collection, creation and diffusion : La danse \nde l’ours.</p>\n<p>The Four Seasons of Paanajärvi received support from the SCAM, Défi Jeune, the Juminkeko foundation and <a href=\"http://www.radiogrenouille.com\" rel=\"nofollow\">Radio Grenouille</a>.</p>\n<p>Recordings made in Paanajärvi in May 2011<br />\nNo additional effect</p>\n<p>Listen And the sun came up <a href=\"http://euphonia.radiogrenouille.com/audio/RADIA/radia_s27_n340_grenouille_and-the-sun-came-up.mp3\" rel=\"nofollow\">HERE</a></p>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"27","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Radio Grenouille","title":"Show 0340: And the sun came up by Nicolas Perret, Cedric Anglaret  (Radio Grenouille)","publicdate":"2017-05-01 22:27:29","uploader":"radia.fm@gmail.com","addeddate":"2017-05-01 22:27:29","date":"2011-10-03","creator":"Radio Grenouille","backup_location":"ia906403_12","external_metadata_update":"2019-04-16T05:28:00Z"},"server":"ia601409.us.archive.org","uniq":324653785,"workable_servers":["ia601409.us.archive.org","ia801409.us.archive.org"]}