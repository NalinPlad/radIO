c21bc1c25245270b5e5e49f2c"},{"name":"radia_s21_n233_soundart_why_dont_you_go_home.mp3","source":"original","size":"44691613","format":"VBR MP3","title":"Why Don't You Go Home?","creator":"Cathryn Morgan Richards","album":"Radia Season 21","track":"233","mtime":"1285165609","md5":"acecc305cb6fadd3cf181ba2167e3387","crc32":"56db465e","sha1":"7f92649d5db8e7cbe75d5e0a346ea66b7aaa5731","length":"1608.39","height":"0","width":"0","artist":"Cathryn Morgan Richards","external-identifier-match-date":"acoustid:2019-03-18T21:08:33Z","external-identifier":"urn:acoustid:110d05cd-6b5b-41a5-b94e-69a61809d2f4"},{"name":"radia_s21_n233_soundart_why_dont_you_go_home.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s21_n233_soundart_why_dont_you_go_home.mp3","mtime":"1492336066","size":"19080610","md5":"836a1ac64437bcad8dcbb0747f5ecbd2","crc32":"c846b914","sha1":"f5f1071a7e9fb007b0be95a0eb7a6be1eea47796","length":"1679.96","height":"0","width":"0"},{"name":"radia_s21_n233_soundart_why_dont_you_go_home.png","source":"derivative","format":"PNG","original":"radia_s21_n233_soundart_why_dont_you_go_home.mp3","mtime":"1492336110","size":"11797","md5":"144aa5b10c2efb6311b9694f39ef202d","crc32":"d2f674c0","sha1":"c61ec524fc5e1e1bd21d9a638d12143ca5099c76"}],"files_count":11,"item_last_updated":1709382170,"item_size":64046120,"metadata":{"identifier":"RadiaSeason021233","title":"Show 0233: Why Don’t You Go Home? by Cathryn Morgan Richards (Soundart Radio)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 233 of season 21 of the <a href=\"http://www.radia.fm\" rel=\"nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://www.soundartradio.org.uk\" rel=\"nofollow\">Soundart</a>. \n\nIt was broadcasted in all Radia stations in the week between 14.09.2009 and  20.09.2009 \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"nofollow\">Read about Radia on wikipedia.</a>\n\n--\n\n\nWhy Don't You Go Home? by Cathryn Morgan Richards from Soundart Radio  []\nDonald Crowhurst set sail from Teignmouth, South Devon UK, in the autumn of 1968 on a non-stop round-the-world sailing race in his trimaran âTeignmouth Electronâ. One of nine competitors, Crowhurst saw his initial high hopes for fame and glory dashed when lack of time, a poorly equipped boat and inexperience all conspired against him. With the realisation that neither he nor the boat were up to the trip came desperation, which led to a faked voyage, a breakdown and ultimately his death.\n\nâWhy donât you go home?â by sound artist Cathryn Morgan-Richards tells the Crowhurst story in the form of a radio documentary, through the accounts of people local to Teignmouth who were in some way witness to what happened. With a backdrop of soundscapes taken from the Teign Estuary, the piece combines spoken voices with an underlying musicality, blurring the boundary between documentary and sonic art.","subject":"radio art;Radia;Soundart Radio","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-09-22 14:28:50","addeddate":"2010-09-22 14:25:13","uploader":"radia.fm@gmail.com","updatedate":"2010-09-22 14:29:05","updater":"Radia.fm","boxid":"OL100020612","backup_location":"ia903606_17","date":"2009-09-14","radiaseason":"21","creator":"Soundart Radio"},"server":"ia601308.us.archive.org","uniq":1838125003,"workable_servers":["ia601308.us.archive.org","ia801308.us.archive.org"]}