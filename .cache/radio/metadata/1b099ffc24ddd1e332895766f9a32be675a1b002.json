0"},{"name":"radia_s21_n242_Corax_volcano_ALG.mp3","source":"original","size":"67144860","format":"VBR MP3","title":"Mayon Volcano","creator":"Andreas Loeschner Gornau","album":"Radia Season 21","track":"242","mtime":"1285154620","md5":"4ef2396fb6cd423a4234c599adf15f18","crc32":"7bba6c06","sha1":"fedbb666a6210e6529c27430f433c9680323207f","length":"1678.62","height":"0","width":"0","external-identifier":"urn:acoustid:aa32d8e3-f7bf-4c04-876e-72922a83adef","external-identifier-match-date":"acoustid:2019-04-12T14:44:55Z"},{"name":"radia_s21_n242_Corax_volcano_ALG.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s21_n242_Corax_volcano_ALG.mp3","mtime":"1492336098","size":"17555548","md5":"1c83af87fce5cffe75717cf1ef6861ab","crc32":"8d848be8","sha1":"15ca1e7287420310de2e8cfb69229ef201b1370d","length":"1680.07","height":"0","width":"0"},{"name":"radia_s21_n242_Corax_volcano_ALG.png","source":"derivative","format":"PNG","original":"radia_s21_n242_Corax_volcano_ALG.mp3","mtime":"1492336128","size":"10296","md5":"08123cd5415c10f4ba46330008f357d9","crc32":"9162b572","sha1":"086051ab07828a48b318a2f0aadb2a47dc3bf356"}],"files_count":11,"item_last_updated":1739176720,"item_size":85108752,"metadata":{"identifier":"RadiaSeason021242","title":"Show 0242: Mayon Volcano by Andreas Loeschner Gornau (Radio Corax)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 242 of season 21 of the <a href=\"http://www.radia.fm\" rel=\"ugc nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://radiocorax.de/\" rel=\"ugc nofollow\">Radio Corax</a>. \n\nIt was broadcasted in all Radia stations in the week between 23.11.2009 and  29.11.2009 \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"ugc nofollow\">Read about Radia on wikipedia.</a>\n\n--\n\nMayon Volcano\n\nMayon Volcano is the title of a multi-layer art work by Andreas Loeschner Gornau, an artist from Halle living on philippines.\nLoeschner visited the island from 2006 on different times- also during the catastrophe in 2006 after long rain and volcano activities. Our half an hour pictures the emotional impacts during the travels. Loeschners voice got a little help by his personal computer.","subject":"radio art;Radia;Radio Corax","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-09-22 11:34:02","addeddate":"2010-09-22 11:21:12","uploader":"radia.fm@gmail.com","updatedate":"2010-09-22 11:49:33","updater":"Radia.fm","boxid":"OL100020611","backup_location":"ia903606_17","date":"2009-11-16","radiaseason":"21","creator":"Radio Corax","external_metadata_update":"2019-04-12T14:44:55Z"},"server":"ia800605.us.archive.org","uniq":1425530978,"workable_servers":["ia800605.us.archive.org","ia600605.us.archive.org"]}