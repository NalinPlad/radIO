4b72186f9"},{"name":"radia_s21_n239_MobileRadio_Morsonata.mp3","source":"original","size":"53761467","format":"VBR MP3","title":"Morsonata","creator":"Mobile Radio","album":"Radia Season 21","track":"239","mtime":"1285157335","md5":"709f7aa54fbe8dcb27606929c5ca09fe","crc32":"6249ec42","sha1":"290e80549c37c042e08c9040ff766fe262384d47","length":"1680.05","height":"0","width":"0","artist":"Mobile Radio","genre":"Other","external-identifier-match-date":"acoustid:2019-03-26T17:39:41Z","external-identifier":"urn:acoustid:4c6b2d4f-34fa-4cf2-b63f-d909ad8ee00f"},{"name":"radia_s21_n239_MobileRadio_Morsonata.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s21_n239_MobileRadio_Morsonata.mp3","mtime":"1492336107","size":"20837621","md5":"6821329de3adfd48a793e20693a6538f","crc32":"dec86ee1","sha1":"d73ffefafb5266a58219f9493b425936ce551c60","length":"1680.04","height":"0","width":"0"},{"name":"radia_s21_n239_MobileRadio_Morsonata.png","source":"derivative","format":"PNG","original":"radia_s21_n239_MobileRadio_Morsonata.mp3","mtime":"1492336154","size":"10925","md5":"1dc235e53f105fa4e79a2674e86705ea","crc32":"65121c1b","sha1":"eece77e9f2249feaf4256a5fcccdd39b00a49cc8"}],"files_count":11,"item_last_updated":1708509186,"item_size":74977292,"metadata":{"identifier":"RadiaSeason021239","title":"Show 0239: Morsonata by Mobile Radio (Resonance FM)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 239 of season 21 of the <a href=\"http://www.radia.fm\" rel=\"nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://mobile-radio.net/\" rel=\"nofollow\">Radio Mobile</a> to replace a missing show by Panik.\n\nIt was broadcasted in all Radia stations in the week between 26.10.2009 and  01.11.2009 \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"nofollow\">Read about Radia on wikipedia.</a>\n\n--\n\n MORSONATA\n\nThis is the radia edit of a hour long live radio show produced by Mobile Radio for the FON festival in Barrow-in-Furness, England. With Barrow being home to Europe's biggest submarine shed and neighbouring Lake District having hosted Kurt Schwitters for the last years of his life we decided to combine these two influences. Schwitters' Ursonate performed in morse code by one of Barrow's retired submariners is the underlying thread to the show that includes live music and field recordings by FON artists in residence Haco, Susan Matthews, Sarah Washington and Knut Aufermann.\n\n\nFestival: http://fullofnoises.blogspot.com/\nMobile Radio: http://mobile-radio.net","subject":"radio art;Radia;Resonance FM","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-09-22 13:16:45","addeddate":"2010-09-22 12:07:42","uploader":"radia.fm@gmail.com","updatedate":"2010-09-22 13:18:53","updater":"Radia.fm","boxid":"OL100020612","backup_location":"ia903606_17","date":"2009-10-26","radiaseason":"21","creator":"Resonance FM","year":"2009","external_metadata_update":"2019-03-26T17:39:41Z"},"server":"ia800200.us.archive.org","uniq":1816189459,"workable_servers":["ia800200.us.archive.org","ia600200.us.archive.org"]}