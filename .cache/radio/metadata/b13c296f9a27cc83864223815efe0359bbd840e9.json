3dc4b1c40eb43c9bb941fcd92f78"},{"name":"history/files/Collection_Header.png.~1~","source":"original","mtime":"1515082384","size":"2330","md5":"ff5ab98d3a79752ad9a22a277545eadb","crc32":"d07adee9","sha1":"a605aa21dfaf0baced4bb55c116988630c7aceb4","format":"Unknown","old_version":"true"}],"files_count":15,"item_last_updated":1718169323,"item_size":802321128,"metadata":{"identifier":"RadiaS40N667ExNihiloRadia","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"creator":"Radio Grenouille","date":"2018-01-08","description":"\n\n\n\n\n\n\n\n\n\n\n\n\n<p class=\"MsoNormal\"><span lang=\"en\" xml:lang=\"en\">The Lebanese\nartist Kinda Hassan decrypts the Marseille \"kaleidoscope\" through a\nsound installation entitled \"Ex Nihilo (nihil fit), nothing comes from\nnothing\", questioning the different stories that mask the contemporary\nfacade of the city.</span></p>\n\n<p class=\"MsoNormal\"><span><span> </span></span><span lang=\"en\" xml:lang=\"en\"><br />\nIn her sound painting, Kinda Hassan presents the city and its port as a subject\nand its mirror, revealing original details often assigned today to the margin,\nto oblivion.<br />\nThese are details illustrating a daily life marked by life at the seaside:\nhours spent waiting for boats, bodies carrying tons of goods, products\nanimating the markets of the city, shops that are born on the sea. corpses of\ntheir antecedents.<br />\nThese are details evoking breaks, silences and ends.<br />\nIt is an intimate encounter with a story in which the city is related to its\nfundamental roots: Man and his experience of survival.</span><span></span></p>\n\n\n\n\n\n","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"40","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Radio Grenouille","title":"Show 0667: Ex Nihilo (nihil fit) by Kinda Hassan (Radio Grenouille)","publicdate":"2018-01-04 16:12:44","uploader":"radia.fm@gmail.com","addeddate":"2018-01-04 16:12:44","backup_location":"ia906605_13","collection_added":"radiostationarchives"},"server":"ia903407.us.archive.org","uniq":1923182604,"workable_servers":["ia903407.us.archive.org","ia803407.us.archive.org"]}