,"sha1":"7d5791c1ac19c0617d36802214c6faf0cc9128ca","format":"Archive BitTorrent"},{"name":"bb-e-06_files.xml","source":"original","format":"Metadata","md5":"a0aa37f64db1a4b056df7f941a5311db","summation":"md5"},{"name":"bb-e-06_meta.sqlite","source":"original","mtime":"1741006289","size":"49152","md5":"9213752e73133ac70e5957cc7778c068","crc32":"efe90879","sha1":"7ddc3eacc0af9fb99ce15f0348647e10af5241d7","format":"Metadata"},{"name":"bb-e-06_meta.xml","source":"original","mtime":"1741006433","size":"4488","md5":"a448541c29e42686698b63dd39b26bf6","crc32":"ede31477","sha1":"2f2b332bdbd84df383a93e9b883fc0446fb3dcb1","format":"Metadata"}],"files_count":11,"item_last_updated":1741006437,"item_size":76175474,"metadata":{"identifier":"bb-e-06","mediatype":"audio","collection":["du-participatory-archive","audio_music"],"creator":"Gus Baxter","date":"2025-02-26","description":"<span style=\"font-size:10pt;font-family:Arial;\">What does it take to build a successful career from the ground up? In this episode of The Bravery Blueprint, host Gus Baxter sits down with John Cevallos, a Drew University alum who turned uncertainty into opportunity. With no job lined up and no safety net, John took a bold leap into international sales, navigating setbacks, layoffs, and tough decisions along the way. Now, with 25 years in the consumer goods industry, he shares the lessons that shaped his journey—how feedback fuels growth, why resilience is the key to success, and how trusting yourself can lead to unexpected breakthroughs. Whether you're a student, a young professional, or someone at a career crossroads, this episode is packed with wisdom and inspiration to help you take your next brave step forward.</span><div><font face=\"Arial\"><span style=\"font-size:13.3333px;\"><br /></span></font></div><div><font face=\"Arial\"><span style=\"font-size:13.3333px;\">Subscribe to the Bravery Blueprint on <a href=\"https://open.spotify.com/show/2V3KScNEkUX6Ps4FnXAsvx?si=lSeh9MdWQ9GDVZKkW1Z0Ng\" rel=\