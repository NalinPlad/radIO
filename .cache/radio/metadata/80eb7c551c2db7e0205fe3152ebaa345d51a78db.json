274d36d2bc2036a8eeb41149dbaad3f5","crc32":"c16b85b4","sha1":"d7609662374241bf732a0ca1d89f698ad86db033"},{"name":"rg-gj_2_esshigh.json.gz","source":"derivative","format":"Essentia High GZ","original":"rg-gj_2_esslow.json.gz","mtime":"1449111450","size":"1784","md5":"0338f03e36eee101c8a412fc2ddb8d1c","crc32":"59885dd9","sha1":"72214992dbc58a991d30cdb7db892c73b211e8b6"},{"name":"rg-gj_2_esslow.json.gz","source":"derivative","format":"Essentia Low GZ","original":"rg-gj_2.mp3","mtime":"1449111335","size":"43922","md5":"44af6f6d623a28110ff771de76f539f6","crc32":"68ff70e5","sha1":"c350552293dc8d8aee9079f2cb577085002f52df"},{"name":"rg-gj_2_spectrogram.png","source":"derivative","format":"Spectrogram","original":"rg-gj_2.mp3","mtime":"1449110947","size":"201815","md5":"9a9449c4179e7027af03e4bdc42357d1","crc32":"4e12cf24","sha1":"79074b05d9f406a7624b67b11e2b99c4862a7e5a"}],"files_count":28,"item_last_updated":1705287477,"item_size":129343147,"metadata":{"identifier":"noise-arch_rg-gj","collection":["noise-arch","cassettetapes"],"date":"2009","description":"A digitized tape from the NOISE-ARCH Archives. Identifier: rg-gj","mediatype":"audio","scanner":"Internet Archive Python library 0.9.8","subject":"Cassette;Tape;Noise-Arch;Independent","title":"NOISE-ARCH: Randy Grief - The Golden Joy Club","publicdate":"2015-12-03 02:42:14","uploader":"jscott@archive.org","addeddate":"2015-12-03 02:42:14","backup_location":"ia905506_3"},"reviews":[{"reviewtitle":"Dark Ambient","reviewbody":"An interesting piece.  \nThis Tape provides intensely atmospheric pieces, maintaining a rhythm with repetitive, almost droning melodies.  The Undertext that some of these songs were made specifically for a Film makes sense, as they're excellent scene-setting.\n\nThe audio quality of this upload is excellent.  You can hear the physicallity of the tape, which, is something I personally appreciate, and given the Genre, it only really adds to it. \n\nMy favorite track is A3: The Rift in the Earth,  the spoken word vocals used as repeating samples bring the almost hypnotic feeling of the music to a head, and paint a stunning picture.\n\nNo Rating, as this review is largely intended for Categorization purposes. ","stars":"0","reviewer":"FoxyShibata","reviewdate":"2024-01-15 02:57:49","createdate":"2024-01-15 02:57:49","reviewer_itemname":"@foxyshibata"}],"server":"ia601302.us.archive.org","uniq":1142136555,"workable_servers":["ia601302.us.archive.org","ia801302.us.archive.org"]}