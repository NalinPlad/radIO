at":"Metadata"},{"name":"Bessie_Smith_Tape_3_1930-1933_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"Bessie_Smith_Tape_3_1930-1933.jpg","mtime":"1369785344","size":"5276","md5":"ae71f64f7c74f3d5b84d14b33b9bdd9a","crc32":"29726135","sha1":"7f89e7c2353db1a582460de77f900fedcde824ee"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1541634810","size":"16577","md5":"7d063772c3f2a9030921dcfc7b296e90","crc32":"38240644","sha1":"ae5c656c414aa51cfc45c9256b5cb1a472cc3fcc","format":"Item Tile","rotation":"0"}],"files_count":22,"item_last_updated":1541634819,"item_size":1207937912,"metadata":{"identifier":"Bessie_Smith_Tape_3_1930-1933","date":"1933","description":"From the David W. Niven Collection of Jazz History, a cassette recording from the Jazz artist Bessie Smith, from the era of 1930-1933. Tape 3. <p>Recorded with a TEAC AD-500 cassette deck, a desktop computer with a modern SoundBlaster sound card, and the audio recording program GoldWave.  Each cassette was recorded to a single WAV-format file at 44100 kHz, 16-bit quality, to match the quality of CD-audio. Each resulting WAV file was split at the division between Side A and Side B of the cassette, in order to make it possible for each WAV file to fit on a single 80-minute CD.</p>","language":"eng","mediatype":"audio","title":"Niven Jazz Collection: Bessie Smith Tape 3 (1930-1933)","collection":"davidwnivenjazz","publicdate":"2013-05-28 23:47:28","uploader":"jscott@archive.org","addeddate":"2013-05-28 23:47:28","boxid":"OL100020605","backup_location":"ia905701_15"},"reviews":[{"reviewbody":"Fantastic tapes!! See this page under Community Audio for a tracked version of the Bessie Smith tapes in the David W Niven Jazz Collection: \nhttps://archive.org/details/BessieSmithNivenJazzCollection_tracked","reviewtitle":"Tracked version available","reviewer":"prbullen","reviewdate":"2015-01-25 08:24:25","createdate":"2015-01-25 08:24:25","stars":"5"}],"server":"ia601406.us.archive.org","uniq":194729718