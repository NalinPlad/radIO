4b3770f64992def"},{"name":"radia_s22_n249_soundart_a_new_year_show.mp3","source":"original","size":"26819047","format":"VBR MP3","title":"A New Year Show","creator":"Lucinda Guy","album":"Radia Season 22","track":"249","mtime":"1285139963","md5":"0244b98584d9109ea2195f6ee7ebd379","crc32":"ff60f18d","sha1":"16b6a824e77f2a09a3ef62704d6a4fd49eb9cc16","length":"1676.19","height":"0","width":"0","genre":"story","artist":"Lucinda Guy","external-identifier-match-date":"acoustid:2019-04-04T19:49:08Z","external-identifier":"urn:acoustid:738e9cd0-aebb-40cf-883a-7f05f3034185"},{"name":"radia_s22_n249_soundart_a_new_year_show.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s22_n249_soundart_a_new_year_show.mp3","mtime":"1492336144","size":"18377054","md5":"ff9d4ac40dafc258bb6a7d801186b594","crc32":"dcf9e9bd","sha1":"2ef1c64592a3cbb60da516b499cb7c333e66bb7b","length":"1680.04","height":"0","width":"0"},{"name":"radia_s22_n249_soundart_a_new_year_show.png","source":"derivative","format":"PNG","original":"radia_s22_n249_soundart_a_new_year_show.mp3","mtime":"1492336189","size":"11416","md5":"333d7b55f2077ca223a0b4858742c7e0","crc32":"6ac694b0","sha1":"5c626dfd6b43609e77d5521982a4af70cd918f13"}],"files_count":11,"item_last_updated":1709635071,"item_size":45514425,"metadata":{"identifier":"RadiaSeason022249","title":"Show 0249: A New Year Show by Lucinda Guy (Soundart Radio)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 249 of season 22 of the <a href=\"http://www.radia.fm\" rel=\"nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://www.soundartradio.org.uk\" rel=\"nofollow\">Soundart</a>. \n\nIt was broadcasted in all Radia stations in the week between 04.01.2010 and 10.01.2010. \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"nofollow\">Read about Radia on wikipedia.</a>\n\n--\n\nA New Year Show, from Soundart Radio 102.5fm, Dartington UK\n\nThis is a traditional story about when the moon fell in the river, became trapped by bad fairies and rescued by villagers.\nI've retold it for Radia including recordings made during the last year, mostly of my children and friends playing in a river.\nThere's also music improvised by children.\nThere are some hymns and carols, some of which first appeared as part of my 'swimming in the stream' radio series, using our station's webstream to create loops and effects.\n\nThanks to:\nChildren at Bidwell Brook school, Dartington, who created some of the music\nCatherine Guy, who sings Shakespeare's full fathom 5 with me\nErgo Phizmiz who reads the part of the man who fell in.\nBeowulf, Artemis, Marlowe and Demeter who played in the river and chatted.\nAriane Delaunois, Nell Harrison and Kate Paxman who also recorded the children at our workshops last summer.\n\nHappy New Year from all at Soundart Radio www.soundartradio.org.uk","subject":"radio art;Radia;Soundart Radio","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-09-22 07:20:46","addeddate":"2010-09-22 07:14:01","uploader":"radia.fm@gmail.com","updatedate":"2010-09-22 07:21:09","updater":"Radia.fm","boxid":"OL100020611","backup_location":"ia903606_17","date":"2010-01-04","radiaseason":"22","creator":"Soundart Radio","external_metadata_update":"2019-04-04T19:49:08Z"},"server":"ia800201.us.archive.org","uniq":1670034623,"workable_servers":["ia800201.us.archive.org","ia600201.us.archive.org"]}