me":"radia_s04_n039_kunstradio_archive.torrent","source":"metadata","btih":"625f71f1785cc6aefb086bc1f341cce14b3c85fc","mtime":"1535434246","size":"6707","md5":"148a224202cbe682e908a149f523ce69","crc32":"8ab15ffc","sha1":"fd36f18c6b50a915e252af53ca637c88f8023db8","format":"Archive BitTorrent"},{"name":"radia_s04_n039_kunstradio_files.xml","source":"original","format":"Metadata","md5":"f284a1420cc7fbd1f1f4f032808b1260","summation":"md5"},{"name":"radia_s04_n039_kunstradio_meta.sqlite","source":"original","mtime":"1493017532","size":"18432","format":"Metadata","md5":"96a71c2290053a6b12b617b4e0701b82","crc32":"57fd7c9d","sha1":"0fec2bb6dc71489a774b88accaa93f17edf3a50d"},{"name":"radia_s04_n039_kunstradio_meta.xml","source":"original","mtime":"1665592492","size":"2171","format":"Metadata","md5":"e4f56b9ccc82f347fce6659688cff026","crc32":"87190069","sha1":"d6846618a09c332e78790cc29c8d0bc0d6cb3408"},{"name":"radia_s04_n039_kunstradio_spectrogram.png","source":"derivative","format":"Spectrogram","original":"radia_s04_n039_kunstradio.ogg","mtime":"1493017715","size":"297198","md5":"d09fc83cb0807b5f34a0bf6a4bbfa6a9","crc32":"a19cc88a","sha1":"4c512d183c433c5c28fbe24276f5c2c645b66d31"}],"files_count":12,"item_last_updated":1665592492,"item_size":96552050,"metadata":{"identifier":"radia_s04_n039_kunstradio","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"creator":"ORF Kunstradio","date":"2005-12-26","description":"“wien wie es klingt” by Gerhard Rühm<br /><div class=\"entry-content\"><p>\nthe radioplay “wien wie es klingt” places 24 significant listening spots\n  of the austrian capital vienna into the framework of a daily routine –\n  something like an acoustic equivalent to two sets of postcards. it  \nbegins in the early morning with the arrival at the railway station. the\n  thematic middle of the piece is marked by the ringing of the bells of \n st. stephen’s cathedral in the center of the city at noon, and the \npiece  ends in the late evening with the departure from the airport at  \nschwechat. strewn in between is a tourist programme which could hardly  \nbe accomplished in one day. a compressed 47 minute sequence was  \ndistilled from the 12 hours of recording and arranged roughly  \nchronologically with regard to normal visiting times in the morning,  \nafternoon, and evening but precluding any kind of realistic plot by  \nmaking geographical leaps all over the city. Produced in 1991/1992 for  \nthe series METROPOLIS at the WDR, Köln (Studio for Akustischer Kunst) in\n  co-production with ORF Kunstradio, Wien.</p>\n<p><a href=\"http://www.kunstradio.at/1992A/18_6_92.html#I\" rel=\"nofollow\">http://www.kunstradio.at/1992A/18_6_92.html</a></p>\n\t\t\t\t\t\t\t\t\t\t\t</div>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"4","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;ORF Kunstradio","title":"Show 0039: wien wie es klingt by Gerhard Rühm (ORF Kunstradio)","publicdate":"2017-04-24 07:04:54","uploader":"radia.fm@gmail.com","addeddate":"2017-04-24 07:04:54","backup_location":"ia906402_30"},"server":"ia801500.us.archive.org","uniq":1616894325,"workable_servers":["ia801500.us.archive.org","ia601500.us.archive.org"]}