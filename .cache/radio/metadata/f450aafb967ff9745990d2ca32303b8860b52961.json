et Archive HTML5 Uploader 1.6.4","subject":"radio art;Radia;Radio Helsinki","title":"Show 0812: Radio Cyborg Transmitter LIVE by Reni Hofmüller, Valentina Vuksic and Max Höfler (Radio Helsinki)","uploader":"radia.fm@gmail.com","publicdate":"2020-10-16 14:57:31","addeddate":"2020-10-16 14:57:31","year":"2020"},"server":"ia601705.us.archive.org","uniq":2002523795,"workable_servers":["ia601705.us.archive.org","ia801705.us.archive.org"]}