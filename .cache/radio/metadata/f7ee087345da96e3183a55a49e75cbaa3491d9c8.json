ghters.jpg","source":"original","mtime":"1566223212","size":"393548","md5":"c4273e470fcada4252df23e3efcba72f","crc32":"6bc61178","sha1":"111bbdb66c07daed81b0941ea11dab56cd60d177","format":"JPEG","rotation":"0"},{"name":"Séverine_Irène_V._Janssen@Mothers&Daughters_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"Séverine_Irène_V._Janssen@Mothers&Daughters.jpg","mtime":"1566223396","size":"3585","md5":"61e821e417524e28bf81a882644ef769","crc32":"d79c9a17","sha1":"177ced257b5e7c391bdf498dad948da95b526db2"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1566751332","size":"12104","format":"Item Tile","rotation":"0","md5":"a4b9de65d0c89930292ccce3cfa3c8d2","crc32":"c995d2f2","sha1":"b5504197468c199d29f29a10fff92ce1cda9ec29"},{"name":"radias33752mothersdaughtersradiocampusbruxelles_archive.torrent","source":"metadata","btih":"2198e9f07272133c85a5ab9c424cdb74884ce51c","mtime":"1566751334","size":"22810","md5":"3e0155d0b24ee2f2a1df9ee8dc344a69","crc32":"2c1aabce","sha1":"268542df879c01cf12c7e32d6518c4df011f97f0","format":"Archive BitTorrent"},{"name":"radias33752mothersdaughtersradiocampusbruxelles_files.xml","source":"original","format":"Metadata","md5":"606cb9e635a9e59ea460bcda0655f1b2","summation":"md5"},{"name":"radias33752mothersdaughtersradiocampusbruxelles_meta.sqlite","source":"original","mtime":"1566751310","size":"52224","format":"Metadata","md5":"e0251cec4e53f0d0e1c475b5cf7cb51f","crc32":"5e70eee3","sha1":"2bf7a727b108495ec1722e24b7c86b26e4c974a2"},{"name":"radias33752mothersdaughtersradiocampusbruxelles_meta.xml","source":"original","mtime":"1750175977","size":"6225","format":"Metadata","md5":"702255a5d7e067454085791b84878308","crc32":"4159a977","sha1":"4ecd75974193ab084a3287c54ade110530785952"}],"files_count":18,"item_last_updated":1750175977,"item_size":482907130,"metadata":{"identifier":"radias33752mothersdaughtersradiocampusbruxelles","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"creator":"Radio Campus","date":"2019-08-26","description":"<p style=\"margin-bottom:0cm;\"><font face=\"Georgia, serif\"><font size=\"3\">In\nthe spring of 2018, the temporary lesbian bar<b> </b><a href=\"https://www.mothersanddaughters.be/\" rel=\"ugc nofollow\"><i><b>Mothers\n& Daughters</b></i></a> opened in Brussels. This opening brought\ntogether a community in deficit. In deficit of place, of celebration\nand of collective rituals. In the wake of this event whose near\ndisappearance made its presence all more precious, Severine Irène V.\nJanssen X BNA-BBOT recorded testimonies, conversations and sounds.\nThese recordings took place in the bar and outside the bar and\nresulted in this radiophonic piece. </font></font>\n</p>\n<p style=\"margin-bottom:0cm;border-top:none;border-bottom:1pt solid #000000;border-left:none;border-right:none;padding-top:0cm;padding-bottom:0.07cm;padding-left:0cm;padding-right:0cm;\">\n<br /></p>\n<p style=\"margin-bottom:0cm;\"><br /></p>\n<p style=\"margin-bottom:0cm;\"><font face=\"Georgia, serif\"><font size=\"3\"><font color=\"#000000\"><span style=\"font-style:normal;\"><b><a href=\"http://www.bna-bbot.be/\" rel=\"ugc nofollow\">BNA-BBOT</a> </b></span></font><font color=\"#000000\"><span style=\"font-style:normal;\"><span style=\"font-weight:normal;\">is</span></span></font><font color=\"#000000\"><span style=\"font-style:normal;\"><b> </b></span></font><font color=\"#000000\"><span style=\"font-style:normal;\"><span style=\"font-weight:normal;\">a Brussels-based organisation dedicated to the past, present and future\nsound memory of Brussels. Since 2000, BNA-BBOT generates a history\nand memory of the city through the stories and memories of its\ninhabitants. We’ve compiled closed to 20.000 items of sound data –\nwitness accounts, snippets of conversations, monologues, songs,\nsoundscapes and raw sounds – that form the history of the city. A\nkind of documentative experience over a very long course, which is\nnot only intended to capture the voices and sounds that pass, but to\nalso create multiple forms that can be heard and returned to the\ncity. All this, in order to have the city actively rework its living\nmemory, and the memory – both present and future – constantly\nreworked by the city.</span></span></font></font></font></p>\n<p style=\"margin-bottom:0cm;\"><br /></p>\n<p style=\"margin-bottom:0cm;font-style:normal;font-weight:normal;\">\n<font color=\"#000000\"><font face=\"Georgia, serif\"><font size=\"3\"><b>Séverine\nIrène V. Janssen</b> lives and works in Brussels. She studied\nphilosophy but her passion for the way in which history is conceived,\nwritten, commented and transmitted, as well as her interest in memory\nas a political and aesthetic subject led her to take on coordination\nfor BNA-BBOT in 2009. </font></font></font>\n</p>\n<p style=\"margin-bottom:0cm;font-style:normal;font-weight:normal;\">\n<br /></p>\n<p style=\"margin-bottom:0cm;\"><font face=\"Georgia, serif\"><font size=\"3\"><b>Credits\nmusic </b>: </font></font>\n</p>\n<p style=\"margin-bottom:0cm;font-style:normal;font-weight:normal;\">\n<font color=\"#000000\"><font face=\"Georgia, serif\"><font size=\"3\"><i>Make\nYour Dreams Television</i> – <a href=\"http://ooooo.be/planeteconcrete/\" rel=\"ugc nofollow\">Planète\nConcrète</a></font></font></font></p>\n<p style=\"margin-bottom:0cm;font-style:normal;font-weight:normal;\">\n<font color=\"#000000\"><font face=\"Georgia, serif\"><font size=\"3\"><i>Küss\nMich Wund</i> - Planète Concrète</font></font></font></p>\n<p style=\"margin-bottom:0cm;font-style:normal;font-weight:normal;\">\n<font color=\"#000000\"><font face=\"Georgia, serif\"><font size=\"3\"><i>Tropical\nvibration</i> - Planète Concrète</font></font></font></p>\n<p style=\"margin-bottom:0cm;font-style:normal;font-weight:normal;\">\n<font color=\"#000000\"><font face=\"Georgia, serif\"><font size=\"3\"><i>What\nI Would</i> - <a href=\"https://nadiabekkers.com/\" rel=\"ugc nofollow\">MC Mustaj</a></font></font></font></p>\n<p style=\"margin-bottom:0cm;font-style:normal;font-weight:normal;\">\n<font color=\"#000000\"><font face=\"Georgia, serif\"><font size=\"3\"><i>Highway</i>\n- <a href=\"https://www.facebook.com/grannnde/\" rel=\"ugc nofollow\">Grande</a></font></font></font></p>\n<p style=\"margin-bottom:0cm;\"><br /></p>\n<p style=\"margin-bottom:0cm;\"><font face=\"Georgia, serif\"><font size=\"3\"><font color=\"#000000\"><b>Production</b></font> :\nBNA-BBOT, 2019</font></font></p>\n<p style=\"margin-bottom:0cm;\"><font face=\"Georgia, serif\"><font size=\"3\">(Curated\nby Carine Demange & Radio Campus Bruxelles for Radia network)</font></font></p>","scanner":"Internet Archive HTML5 Uploader 1.6.4","subject":"radio art;Radia;Radio Campus","title":"Show 0752: MOTHERS & DAUGHTERS by BNA-BBOT (Radio Campus)","publicdate":"2019-08-19 13:59:56","uploader":"radia.fm@gmail.com","addeddate":"2019-08-19 13:59:56","year":"2019","radiaseason":"43","backup_location":"ia906909_17","collection_added":"radiostationarchives"},"server":"ia800706.us.archive.org","uniq":1279726794,"workable_servers":["ia800706.us.archive.org","ia600706.us.archive.org"]}