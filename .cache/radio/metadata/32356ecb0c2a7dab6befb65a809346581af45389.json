bc692ded42481e8","length":"25625.71","height":"0","width":"0","filecount":"1"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1541664589","size":"2851","md5":"9482e31af74abcba1560e1adcc03b1ca","crc32":"c888a068","sha1":"e38140102b823fe5b245e65c3281697ccb975b7f","format":"Item Tile","rotation":"0"}],"files_count":21,"item_last_updated":1547518853,"item_size":2180773070,"metadata":{"mediatype":"audio","identifier":"Peter_Lamborn_Wilson_lecture__Woman_in_t_93P103","type":"sound","publicdate":"2004-11-30 18:01:44","creator":"Wilson, Peter Lamborn","description":"A Peter Lamborn Wilson lecture on utopian communities in America, including a 17th century community of mystics founded by Johannes Kelpius and known as The Society of the Woman in the Wilderness. Wilson divides communities into two types: platonic (based on an authoritarian, usually Christian, ideology) and anti-platonic (based on autonomy and equality). He evaluates communities according to how they perceive nature and wilderness, putting his discussion in the context of the differences in outlook between the indigenous peoples of America and the European colonists, and focusing on those colonists who joined Indian communities or incorporated native ideas and customs into their way of life. Wilson concludes by playing some hymns by Johannes Kelpius.","licenseurl":"http://creativecommons.org/licenses/by-nd-nc/1.0/","date":"1993-07-27 00:00:00","collection":["naropa","audio_bookspoetry"],"title":"Peter Lamborn Wilson lecture, Woman in the wilderness, July, 1993.","uploader":"parker@archive.org","addeddate":"2004-11-16 16:42:34","adder":"parker@archive.org","pick":"0","runtime":"1:34:28","taper":"Jack Kerouac School of Disembodied Poetics","publisher":"Jack Kerouac School of Disembodied Poetics","naropa_identifier":"93P103","event":"Lecture","updater":"unix:etree","curation":"[curator]validator@archive.org[/curator][date]20140408012107[/date][comment]checked for malware[/comment]","boxid":"OL100020515","backup_location":"ia903600_7"},"reviews":[{"reviewbody":"An enlightening romp through underground movements and thought in American history. Interesting hymns performed around 1:29 (1st written music in North America??)\n\nBooks Mentioned: \nWriter and the Shaman: Elemeire Zolla\nRegeneration through Violence: Slotkin \nDreamtime: Concerning the Boundary between Wilderness and Civilization: Duerr\n<a href=\"http://www.swarthmore.edu/SocSci/bdorsey1/41docs/19-mor.html\" rel=\"nofollow\">Revels in New Canaan</a>: Morton\nRosicrucian Enlightenment: Francis Yates\nBackwood Utopias: Bestor, Arthur","reviewtitle":"Underground Histories","reviewer":"Blank","reviewer_itemname":"@blank","reviewdate":"2018-12-22 15:22:43","createdate":"2005-03-04 13:21:11","stars":"4"}],"server":"ia904606.us.archive.org","uniq":2056542116,"workable_servers":["ia904606.us.archive.org","ia804606.us.archive.org"]}