d":1708961987,"item_size":521554216,"metadata":{"identifier":"radia_s46_n858_Kunstradio_Toxic_Temple","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"creator":"ORF Kunstradio","date":"2021-09-06","description":"<p class=\"MsoNormal\" style=\"margin:0cm 0cm 8pt;line-height:15.6933px;font-size:11pt;font-family:Calibri, sans-serif;\"><span style=\"font-size:14pt;line-height:19.9733px;\" xml:lang=\"en-us\" lang=\"en-us\">Depleted soil, over-asi: dic seas, polluted atmospheres.<br />People are haunted by what they have suppressed. They can no longer escape the toxic.<br /><br />In their long-term art project “Toxic Temple”, Anna Lerchbaumer and Kilian Jörg, approach the beauty of oil streaks, the grandeur of techno scrap, the sublimeness of radioactivity and the tran: scen: dence of extinction.</span></p><p></p><p class=\"MsoNormal\" style=\"margin:0cm 0cm 8pt;line-height:15.6933px;font-size:11pt;font-family:Calibri, sans-serif;\"><span style=\"font-size:14pt;line-height:19.9733px;\" xml:lang=\"en-us\" lang=\"en-us\"><br />Building on their previous research for their project “Toxic Temple”, the two young artists acoustically and poetically explore the connections between spiritu: ality and tox: isi: ty.</span></p><p></p><p class=\"MsoNormal\" style=\"margin:0cm 0cm 8pt;line-height:15.6933px;font-size:11pt;font-family:Calibri, sans-serif;\"><span style=\"font-size:14pt;line-height:19.9733px;\" xml:lang=\"en-us\" lang=\"en-us\">Toxic Temple by Anna Lerchbaumer and Kilian Jörg</span></p><p></p>","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","radiaseason":"46","scanner":"Internet Archive HTML5 Uploader 1.6.4","subject":"radio art;Radia;ORF Kunstradio","title":"Show 0858: Toxic Temple by Anna Lerchbaumer and Kilian Jörg (ORF Kunstradio)","uploader":"radia.fm@gmail.com","publicdate":"2021-09-05 12:02:28","addeddate":"2021-09-05 12:02:28","year":"2021"},"server":"ia802300.us.archive.org","uniq":416500991,"workable_server