40-1945_reviews.xml","source":"original","mtime":"1755020390","size":"913","md5":"960719f33c82b52143c2c2972e839884","crc32":"da717a81","sha1":"69aef3bc1fc1925488ba715282189c0a81506b48","format":"Metadata"},{"name":"Charlie_Parker_Tape_1_1940-1945_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"Charlie_Parker_Tape_1_1940-1945.jpg","mtime":"1369789396","size":"7514","md5":"dea9c00bd19a7eee9eff245ea0ac259f","crc32":"eb5a31b9","sha1":"8cb1420a22691f2d1f704b6910fe17cef68cc19d"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1755020392","size":"22302","md5":"aea80b872fd678e8ad0a310ac514c0e9","crc32":"c82bb54c","sha1":"2595468f241217d83663c5aea60983338a351f6e","format":"Item Tile","rotation":"0"}],"files_count":22,"item_last_updated":1755020401,"item_size":1762098930,"metadata":{"identifier":"Charlie_Parker_Tape_1_1940-1945","date":"1945","description":"From the David W. Niven Collection of Jazz History, a cassette recording from the Jazz artist Charlie Parker, from the era of 1940-1945. Tape 1. <p>Recorded with a TEAC AD-500 cassette deck, a desktop computer with a modern SoundBlaster sound card, and the audio recording program GoldWave.  Each cassette was recorded to a single WAV-format file at 44100 kHz, 16-bit quality, to match the quality of CD-audio. Each resulting WAV file was split at the division between Side A and Side B of the cassette, in order to make it possible for each WAV file to fit on a single 80-minute CD.</p>","language":"eng","mediatype":"audio","title":"Niven Jazz Collection: Charlie Parker Tape 1 (1940-1945)","collection":"davidwnivenjazz","publicdate":"2013-05-29 00:54:33","uploader":"jscott@archive.org","addeddate":"2013-05-29 00:54:33","boxid":"OL100020605","backup_location":"ia905701_15"},"reviews":[{"reviewtitle":"Thank you Mr. Niven","reviewbody":"Hi Mr. Niven. Your love of this music is a gift to me and anyone with a genuine interest in jazz. Thank you for your educational support and depth of knowledge and understanding. You were a contemporary of this music and share information and context now forgotten or ignored. The honesty of your presentation and wish to share is an exceptional gift, a trait of the most effective of educators.","stars":"5","reviewer":"Campfire Bob Songs","reviewdate":"2025-08-12 17:39:46","createdate":"2025-08-12 17:39:46","reviewer_itemname":"@cfb4u_audio"}],"server":"ia801907.us.archive.org","uniq":1023015411,"workable_servers":["ia801907.us.archive.org","ia601907.us.archive.org"]}