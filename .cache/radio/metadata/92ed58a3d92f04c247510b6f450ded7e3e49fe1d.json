,"source":"original","mtime":"1664387772","size":"1827","md5":"64e1ef7b55cc7ecad9484c072d8593d2","crc32":"f3a39a49","sha1":"8dc23c01f1b9b78795f34ce02e342bc2a9fe79c0","format":"Metadata"}],"files_count":8,"item_last_updated":1664387774,"item_size":145549340,"metadata":{"identifier":"nrf-1986-09-29","mediatype":"audio","creator":"Joe Patrych and Bruce Posner","date":"1986-09-29","description":"<div><i>Concert Grande</i>, hosted by Joe Patrych and Bruce Posner, aired on WFUV radio in New York City from July 1977 until July 1993. It featured keyboard performers, some of whom were also composers.</div><div><br /></div><div>NRF was a panel discussion show in which a group of three musicians each gave their first impressions after hearing recordings without knowing who the performer was.</div><div><br /></div><div>This show aired on September 29, 1986 and featured panelists Daniel Berman, Mark Grant, and Bruce Posner, with Joe Patrych as moderator.</div><div><br /></div><div>Haydn - Sonata in C Major, Hob.XVI:50</div><div>Liszt - Un Sospiro; Nuages Gris; Bagatelle without tonality</div><div>Rachmaninov - Piano Concerto #4, Op. 40 (first movement)</div>","language":"eng","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","scanner":"Internet Archive HTML5 Uploader 1.7.0","subject":"radio show; Concert Grande; Bruce Posner; Joe Patrych; panel discussion","title":"Concert Grande - New Record Forum (NRF) 1986-09-29","uploader":"bfposner@pipeline.com","publicdate":"2022-08-21 13:44:32","addeddate":"2022-08-21 13:44:32","curation":"[curator]validator@archive.org[/curator][date]20220821134500[/date][comment]checked for malware[/comment]","collection":["concert-grande-radio","radioprograms"]},"server":"ia801401.us.archive.org","uniq":1611822280,"workable_servers":["ia801401.us.archive.org","ia601401.us.archive.org"]}