on":["noise-arch","cassettetapes"],"date":"2009","description":"A digitized tape from the NOISE-ARCH Archives. Identifier: va-usc","mediatype":"audio","scanner":"Internet Archive Python library 0.9.8","subject":"Cassette;Tape;Noise-Arch;Independent","title":"NOISE-ARCH Collection: va-usc","publicdate":"2015-12-03 03:26:32","uploader":"jscott@archive.org","addeddate":"2015-12-03 03:26:32","backup_location":"ia905506_3"},"reviews":[{"reviewtitle":"My first review written inside the Taj Mahal","reviewbody":"Couldn't find any discogs info on it... but this one can really suck you in, the loops are very hypnotic, if the voices pull you back from trance a little harshly. This one wants to induce heavy trance, with nonstop disruption,, but moments of surrender are hidden at certain inconspicuous spots. You can't find them while you are trying. So while this is not a perfect tape, I will give it a perfect rating. ","stars":"5","reviewer":"skoalbandit","reviewdate":"2021-05-07 04:30:52","createdate":"2021-05-07 04:30:52","reviewer_itemname":"@skoalbandit"}],"server":"ia801307.us.archive.org","uniq":401156850,"workable_servers":["ia801307.us.archive.org","ia601307.us.archive.org"]}