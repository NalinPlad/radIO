1fc79c"},{"name":"radia_s28_n368_xlair_voxpop_archive.torrent","source":"metadata","btih":"1fa14175ed1a8c8c8556510df03287d6a9df6b7d","mtime":"1538944066","size":"4454","md5":"cd1d09032f3c3f08b5c6a3921156605a","crc32":"27413731","sha1":"e59364ed6265c71c9fb13238b661293cf36e60af","format":"Archive BitTorrent"},{"name":"radia_s28_n368_xlair_voxpop_files.xml","source":"original","format":"Metadata","md5":"3792a453a6c112fe8acab504d0c01874","summation":"md5"},{"name":"radia_s28_n368_xlair_voxpop_meta.sqlite","source":"original","mtime":"1493841713","size":"18432","format":"Metadata","md5":"295951df99551b1055472f28b38bfcaa","crc32":"8ac56b24","sha1":"9cd50867004b41d90465a0eaae80d8eb3925f186"},{"name":"radia_s28_n368_xlair_voxpop_meta.xml","source":"original","mtime":"1668388407","size":"1962","format":"Metadata","md5":"5fcc44703cba0c22c288f63598415b92","crc32":"b8b01699","sha1":"8c26218824d1e96c8b75e98ea297e054314d5bd4"}],"files_count":11,"item_last_updated":1668388407,"item_size":42280649,"metadata":{"identifier":"radia_s28_n368_xlair_voxpop","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"<div class=\"entry-content\">\n\t\t\t\t\t\t<p>This XL AIR production consists of a remix radio composition \nthat builds on material used in RITS installations that were created for\n Bozar Night in November 2011. They both embrace the human voice as a \nmusical instrument.</p>\n<p>The first installation was created collectively by the students of \nthe masterclass audio (Tomas Vogels, Simon Vandegracht and Renee \nVermeire) and is based on a musical composition  that uses only the \nvowels of speech.</p>\n<p>The other installation is called ‘Vozombrascimento’ and was created \nby Dieter Van Dam. The Portuguese words ‘voz’ (voice), ‘sombra’ (shadow)\n and ‘nascimento’ ( birth) form the name of this soundtrack consisting \nout of manipulated voice traces of a newborn human being.</p>\n<p>A cry is the anticipated proof of new life. Not a breath. Not a song.\n Not a word. A cry. This installation was placed in a big echoing space \nthat suggested a sonic shadow of the primordial human cry by using and \nmanipulating recordings of a child’s s singing in his first year of \nlife.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"28","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;XL Air","title":"Show 0368: voxpop (XL Air)","publicdate":"2017-05-03 20:01:11","uploader":"radia.fm@gmail.com","addeddate":"2017-05-03 20:01:11","creator":"XL Air","date":"2012-04-16","backup_location":"ia906403_16"},"server":"ia801406.us.archive.org","uniq":1742654417,"workable_servers":["ia801406.us.archive.org","ia601406.us.archive.org"]}