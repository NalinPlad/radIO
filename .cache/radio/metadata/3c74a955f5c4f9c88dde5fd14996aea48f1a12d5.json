ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s41_n698_radiozero.aif","mtime":"1543094420","size":"20583923","md5":"26ae96b1e889f08e07c9ff7ff546d44a","crc32":"14d971c8","sha1":"c4565c6db8f18aeaf2120612ade724bf706bd318","length":"1680","height":"0","width":"0"},{"name":"radia_s41_n698_radiozero.png","source":"derivative","format":"PNG","original":"radia_s41_n698_radiozero.aif","mtime":"1543094490","size":"10074","md5":"f1ea8a07d8135d2dfada9324f905336f","crc32":"b70c46ec","sha1":"8b00ecd83ac44c85ce7ea5495e0c3a9d0adf9de5"},{"name":"radia_s41_n698_radiozero_archive.torrent","source":"metadata","btih":"5fe521af255e4f3d9de1c0a269ac703e689bbaf6","mtime":"1623654271","size":"22652","md5":"eb6f80b1c924971ebb7caf0d159c18ad","crc32":"d56b6c7a","sha1":"83191c3dc7c84a3410850ae063311b131145e880","format":"Archive BitTorrent"},{"name":"radia_s41_n698_radiozero_files.xml","source":"original","format":"Metadata","md5":"33e8de95265c5c5628bfe0987e2b0bcf","summation":"md5"},{"name":"radia_s41_n698_radiozero_meta.sqlite","source":"original","mtime":"1552089299","size":"23552","format":"Metadata","md5":"13b2b25a29e0fca3bdc59d4e079babd7","crc32":"aa88d380","sha1":"730e949c29c5e5dda017aad28a2838979699bee3"},{"name":"radia_s41_n698_radiozero_meta.xml","source":"original","mtime":"1737830203","size":"2169","format":"Metadata","md5":"26a874ae99409092c2794343608a8788","crc32":"72d4ea64","sha1":"ed5b6f41566026374547e5a125db2dd60bdd12e6"},{"name":"radia_s41_n698_radiozero_spectrogram.png","source":"derivative","format":"Spectrogram","original":"radia_s41_n698_radiozero.aif","mtime":"1543094497","size":"298149","md5":"416dac8d06c3323e7c204114008c269e","crc32":"4d928d9f","sha1":"f7eb6a7c3f375caf8334d42f67689ad1e5b35d06"}],"files_count":14,"item_last_updated":1737830203,"item_size":505667025,"metadata":{"identifier":"radia_s41_n698_radiozero","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"creator":"Rádio Zero","date":"2018-08-13","description":"<div class=\"entry-content\">\n\t\t\t\t\t\t<p>Wherever the earth is crag and scrub, the goats are there—the \nblack ones, girlishly skipping, leaping their little leaps from rock to \nrock. I’ve loved their nerve and frisk since I was small.</p>\n<p>Once my grandfather gave me one of my own. He showed me how I could \nserve myself when I got hungry, from the full-feeling bags there like \nwarmish wineskins, where I’d let my hands linger some before bringing my\n mouth close, so the milk wouldn’t go to waste on my face, my neck, even\n my naked chest, which did happen sometimes, who knows if on purpose, my\n mind dwelling all the while on the savory-smelling vulvazinha. I called\n her Maltesa; she was my horse; I could almost say she was my first \nwoman.</p>\n<p>TEXT BY EUGÉNIO DE ANDRADE<br />\nTRANSLATED FROM THE PORTUGUESE BY ATSURO RILEY<br />\nSHOW CURATED AND PRODUCED BY PAULO RAPOSO</p>\n<p><a href=\"http://radia.fm/wp-content/uploads/2018/08/goats.jpg\" rel=\"ugc nofollow\"><img class=\"alignleft size-full wp-image-6150\" src=\"//web.archive.org/web/2im_/http://radia.fm/wp-content/uploads/2018/08/goats.jpg\" alt=\"\" height=\"573\" width=\"860\" /></a></p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\n\t\t\t\t\t","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/4.0/","radiaseason":"41","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Rádio Zero","title":"Show 0698: Goats learning to swim by Paulo Raposo (Rádio Zero)","publicdate":"2018-11-24 21:17:56","uploader":"radia.fm@gmail.com","addeddate":"2018-11-24 21:17:56","backup_location":"ia906804_20","collection_added":"radiostationarchives"},"server":"ia800805.us.archive.org","uniq":1153257362,"workable_servers":["ia800805.us.archive.org","ia600805.us.archive.org"]}