inal","mtime":"1449186830","size":"11264","format":"Metadata","md5":"7b9ce783cf3c7bc578bc21047228f428","crc32":"393a4e25","sha1":"68e59eaa3dedce96c6e37e98db0ea36e65392495"},{"name":"noise-arch_kdi-r_meta.xml","source":"original","mtime":"1484310263","size":"675","format":"Metadata","md5":"0abb5ebe1df3d72ab99516e0b8bea836","crc32":"bbc2126e","sha1":"4a039bfef57abeba875a69c110db85c3a24fb793"},{"name":"noise-arch_kdi-r_reviews.xml","source":"original","mtime":"1492092882","size":"955","md5":"f995ae41381007380904e89e0f70cfdc","crc32":"de0f371c","sha1":"5281926230eb8e0f33ff4a62db53534145fdd521","format":"Metadata"}],"files_count":19,"item_last_updated":1711304075,"item_size":37924862,"metadata":{"identifier":"noise-arch_kdi-r","collection":["noise-arch","cassettetapes"],"date":"2009","description":"A digitized tape from the NOISE-ARCH Archives. Identifier: kdi-r","mediatype":"audio","scanner":"Internet Archive Python library 0.9.8","subject":"Cassette;Tape;Noise-Arch;Independent","title":"NOISE-ARCH Collection: kdi-r","publicdate":"2015-12-03 01:52:28","uploader":"jscott@archive.org","addeddate":"2015-12-03 01:52:28","backup_location":"ia905506_3"},"reviews":[{"reviewbody":"Based on the cover scan, I first thought the artist was Kali and the title was Dub Inc, but according to the RateYourMusic and Discogs sites, the artist is Kali and Dub Inc, and the title is Refugees.\n\nThe cover scan lists two sides with a total of six songs, but there's only one MP3 which seems to  contain just side one (the first three songs).\n\nThe music is pretty decent reggae, but the confusing cover and missing side two makes me wish whoever had digitized this collection had put a little more research effort into it.","reviewtitle":"Decent reggae","reviewer":"Bice2","reviewdate":"2017-04-13 14:14:40","createdate":"2017-04-13 14:14:40","stars":"3"}],"server":"ia601207.us.archive.org","uniq":33953904,"workable_servers":["ia601207.us.archive.org","ia801207.us.archive.org"]}