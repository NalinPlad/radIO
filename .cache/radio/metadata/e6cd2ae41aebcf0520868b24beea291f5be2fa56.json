8f2e0e1ddc69c2a79351974bc647825008ba6"},{"name":"radia_s23_n263_grenouille_miniatures.mp3","source":"original","size":"66679185","format":"VBR MP3","title":"Miniatures","creator":"Pierre-Yves Mac","album":"Radia Season 23","track":"263","mtime":"1285025034","md5":"78c3f30c6ca61255c37962ac1e2b596d","crc32":"ca92000c","sha1":"8f70f5e5a793bed27164df417135dc34a9901d8c","length":"1666.98","height":"439","width":"513","artist":"Pierre-Yves Macé","external-identifier-match-date":"acoustid:2019-03-18T21:08:27Z","external-identifier":"urn:acoustid:68f4e8e9-4824-4ef4-9a34-ae28efd782ee"},{"name":"radia_s23_n263_grenouille_miniatures.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s23_n263_grenouille_miniatures.mp3","mtime":"1492336262","size":"17560416","md5":"b99ab59e734bc4ddcd2cdee4e06602bf","crc32":"a97f6d79","sha1":"04c3c0ff2e8b2c5f5f292ff6075e3637b6d3661b","length":"1666.06","height":"0","width":"0"},{"name":"radia_s23_n263_grenouille_miniatures.png","source":"derivative","format":"PNG","original":"radia_s23_n263_grenouille_miniatures.mp3","mtime":"1492336308","size":"11730","md5":"71fed596f2c36d6e8675ebd949c0015b","crc32":"ac4469d5","sha1":"9a8d2051685965a323fcd99c2356fad6e9a4216d"}],"files_count":11,"item_last_updated":1691977595,"item_size":84598052,"metadata":{"identifier":"RadiaSeason023263","title":"Show 0263: Miniatures by Pierre Yves Macé (Radio Grenouille)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 263 of season 23 of the <a href=\"http://www.radia.fm\" rel=\"nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://www.grenouille888.org/\" rel=\"nofollow\">Grenouille</a>. \n\nIt was broadcasted in all Radia stations in the week between 12.04.2010 and  18.04.2010. \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"nofollow\">Read about Radia on wikipedia.</a>\n\n--\n\n\"Miniatures\"\n\nRadio Grenouille opens the new season of Radia and celebrates the fifth anniversary of the international soundart network, inviting the composer Pierre-Yves Macé to share his collection of \"Miniatures\".\n\nA subtle mosaic made of \"grands touts and petits riens\" to rub concrete materials to the spirit of the times, dipping into the fluctuating fonds of web, movies and songs.\n\n28 minutes about a meeting between the instant and the unstable, unstructured and restructured songs, exiled voices and transitional piano ...\n\n<a href=\"http://www.pierreyvesmace.com\" rel=\"nofollow\">www.pierreyvesmace.com</a>","subject":"radio art;Radia;Radio Grenouille","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-09-20 23:29:09","addeddate":"2010-09-20 23:01:49","uploader":"radia.fm@gmail.com","updatedate":"2010-09-20 23:31:24","updater":"Radia.fm","boxid":"OL100020611","backup_location":"ia903606_16","date":"2010-04-12","radiaseason":"23","creator":"Radio Grenouille"},"server":"ia802307.us.archive.org","uniq":352937756,"workable_servers":["ia802307.us.archive.org","ia902307.us.archive.org"]}