"original","format":"Metadata","md5":"23c0bcf699ffd96014850cdf80574c71","summation":"md5"},{"name":"nrf-1985-09-16_meta.sqlite","source":"original","mtime":"1660949449","size":"20480","md5":"08e9e72b0210d62e794f4b50d0fa9594","crc32":"37943f73","sha1":"5b1bd35fbf01dc4b88916d9967e4c90ff029535a","format":"Metadata"},{"name":"nrf-1985-09-16_meta.xml","source":"original","mtime":"1664387765","size":"1810","md5":"17d908987226cacddb879ba0f375116a","crc32":"d34efdf2","sha1":"78b37f700ea305e62204e785b40b81b1a7c764d6","format":"Metadata"}],"files_count":10,"item_last_updated":1664387771,"item_size":1023958834,"metadata":{"identifier":"nrf-1985-09-16","mediatype":"audio","creator":"Joe Patrych and Bruce Posner","date":"1985-09-16","description":"<div><i>Concert Grande</i>, hosted by Joe Patrych and Bruce Posner, aired on WFUV radio in New York City from July 1977 until July 1993. It featured keyboard performers, some of whom were also composers.</div><div><br /></div><div>NRF was a panel discussion show in which a group of three musicians each gave their first impressions after hearing recordings without knowing who the performer was.</div><div><br /></div><div>This show aired on September 16, 1985 and featured panelists Jed Distler, Jon Klibonoff, and Bruce Posner, with Joe Patrych as moderator.</div><div><br /></div><div>Schubert - 3 Klavierstücke, D.946, #1, in Eb Minor</div><div>Brahms - Scherzo in Eb Minor, Op. 4</div><div>Chopin - Concerto #2 in F Minor, Op. 21 (finale)</div>","language":"eng","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","scanner":"Internet Archive HTML5 Uploader 1.7.0","subject":"radio show; Concert Grande; Bruce Posner; Joe Patrych; panel discussion","title":"Concert Grande - New Record Forum (NRF) 1985-09-16","uploader":"bfposner@pipeline.com","publicdate":"2022-08-19 22:50:28","addeddate":"2022-08-19 22:50:28","curation":"[curator]validator@archive.org[/curator][date]20220819225111[/date][comment]checked for malware[/comment]","c