:"original","format":"Metadata","md5":"2a191a5afbdf4be508e42668dc668bdd","summation":"md5"},{"name":"nrf-1985-03-11_meta.sqlite","source":"original","mtime":"1660928926","size":"20480","md5":"8fc64d9a81665a4f19b94c46268bbca0","crc32":"11bd6412","sha1":"c1b889a5c8d10d54e46761a8d96c4caed1d8bf18","format":"Metadata"},{"name":"nrf-1985-03-11_meta.xml","source":"original","mtime":"1664387769","size":"1808","md5":"6f806ac4dfc2badd732a41a934a9018b","crc32":"370468f8","sha1":"e1896a1aadae6b02d4f11af6832335fb474699b1","format":"Metadata"}],"files_count":10,"item_last_updated":1664387775,"item_size":890308165,"metadata":{"identifier":"nrf-1985-03-11","mediatype":"audio","creator":"Bruce Posner and Joe Patrych","date":"1985-03-11","description":"<div><i>Concert Grande</i>, hosted by Joe Patrych and Bruce Posner, aired on WFUV radio in New York City from July 1977 until July 1993. It featured keyboard performers, some of whom were also composers.</div><div><br /></div><div>NRF was a panel discussion show in which a group of three musicians each gave their first impressions after hearing recordings without knowing who the performer was.</div><div><br /></div><div>This show aired on March 11, 1985 and featured panelists Donald Isler, Werner Isler, and Joe Patrych, with Bruce Posner as moderator.</div><div><br /></div><div>Beethoven - Sonata in F Minor, Op. 57 (first movement)</div><div>Schumann - Fantasy in C Major, Op. 17 (third movement)</div><div>Scriabin - Sonata #9, Op. 68</div>","language":"eng","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","scanner":"Internet Archive HTML5 Uploader 1.7.0","subject":"radio show; Concert Grande; Bruce Posner; Joe Patrych; panel discussion","title":"Concert Grande - New Record Forum (NRF) 1985-03-11","uploader":"bfposner@pipeline.com","publicdate":"2022-08-19 17:08:22","addeddate":"2022-08-19 17:08:22","curation":"[curator]validator@archive.org[/curator][date]20220819170905[/date][comment]checked for malware[/comment]","co