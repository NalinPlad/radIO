18e2ecfd23524dc1e187dad1aef47bdd90ee21","format":"Metadata"},{"name":"nrf-1984-03-05_meta.xml","source":"original","mtime":"1664387803","size":"1959","md5":"3d80bc6889f9c0e20fd034330bc219e7","crc32":"9db6a93a","sha1":"91b9b1528ec92bda19a2613edb64697d398b4849","format":"Metadata"}],"files_count":8,"item_last_updated":1664387810,"item_size":140486224,"metadata":{"identifier":"nrf-1984-03-05","mediatype":"audio","date":"1984-03-05","description":"<div><i>Concert Grande</i>, hosted by Joe Patrych and Bruce Posner, aired on WFUV radio in New York City from July 1977 until July 1993. It featured keyboard performers, some of whom were also composers.</div><div><br /></div><div>NRF was a panel discussion show in which a group of three musicians each gave their first impressions after hearing recordings without knowing who the performer was.</div><div><br /></div><div>This show aired on March 5, 1984 and featured panelists Daniel Berman, Roman Markowicz, and Joe Patrych, with Bruce Posner as moderator.</div><div><br /></div><div>Schubert - Impromptu in Ab Major, Op. 90 #4</div><div>Beethoven - Piano Concerto #1 in C Major, Op. 15, third movement (Rondo)</div><div>Liszt - Sonata in B Minor, excerpt from the recapitulation (before the fugue) to the end</div><div>Chopin - Mazurka in F Minor, Op. 63 #2</div>","language":"eng","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","scanner":"Internet Archive HTML5 Uploader 1.7.0","subject":"radio show; Concert Grande; Bruce Posner; Joe Patrych; panel discussion","title":"Concert Grande - New Record Forum (NRF) 1984-03-05","uploader":"bfposner@pipeline.com","publicdate":"2022-08-18 12:26:43","addeddate":"2022-08-18 12:26:43","curation":"[curator]validator@archive.org[/curator][date]20220818122718[/date][comment]checked for malware[/comment]","creator":"Bruce Posner and Joe Patrych","year":"1984","collection":["concert-grande-radio","radioprograms"]},"server":"ia801508.us.archive.org","uniq":2069400240,"workable_servers"