dia_s34_n526_WaveFarmWGXC_Videofreex_20150427.wav","mtime":"1478333514","size":"263778","md5":"220df7d7e85e952694c79d1657d9b7d6","crc32":"8563bc2e","sha1":"970cf5c78dc25d16e9da7e5ac701e70d9a953575"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1535571012","size":"4815","md5":"930895b711c8386e7d0c5940ca77284a","crc32":"135a2baa","sha1":"78647824a9e240e90f6a93fce02f90bd75bf48e6","format":"Item Tile","rotation":"0"}],"files_count":14,"item_last_updated":1535571015,"item_size":455714293,"metadata":{"identifier":"RadiaS34N526WaveFarmWGXCVideofreex20150427","mediatype":"audio","collection":["radiafm","radioprograms"],"description":"<h1 class=\"entry-title\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:0px;vertical-align:baseline;clear:both;font-weight:normal;font-family:DaysRegular;color:rgb(210,143,0);line-height:1.3em;font-size:21px;\">Show 526: Videofreex (Wave Farm/WGXC)</h1><div class=\"entry-meta\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:0px;vertical-align:baseline;font-family:'Helvetica Neue', Arial, Helvetica, 'Nimbus Sans L', sans-serif;color:rgb(119,119,119);font-size:12px;\"><span class=\"meta-prep meta-prep-author\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">Posted on</span> <a href=\"http://www.radia.fm/?p=3619\" title=\"8:25 am\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(119,119,119);\" rel=\"nofollow\"><span class=\"entry-date\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">2015/04/27</span></a> <span class=\"meta-sep\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">by</span> <span class=\"author vcard\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\"><a class=\"url fn n\" href=\"http://www.radia.fm/?author=3\" title=\"View all posts by knut\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(119,119,119);\" rel=\"nofollow\">knut</a></span></div><div class=\"entry-content\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:12px 0px 0px;vertical-align:baseline;clear:both;color:rgb(51,51,51);font-family:Georgia, 'Bitstream Charter', serif;font-size:13.8px;\"><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\">Listen to the story of the Videofreex, from some of the original members of the video collective that began in the late 1960s in New York City. After meeting at Woodstock, the video art group was hired by CBS to do “60 Minutes”-meets-“Saturday Night Live” show that gets one pilot made. After that pilot, several CBS executives are fired. But Abbie Hoffman hires members of the group to write the pirate broadcasting chapter in “Steal This Book” and pays them with video transmission equipment. So the Videofreex head upstate to Greene County and start Lanesville TV, what might be America’s first pirate television station. Interviews are excerpted here from many sources: Skip Blumberg and Parry Teasdale speak at a recent Dorsky Museum talk about the group, broadcast by Wave Farm Radio. Jon Nealon, the filmmaker at the helm of the just-released documentary, “Here Come the Videofreex!” is also interviewed here, as is Andrew Ingall, the curator of the show about the group that is at the Dorsky Museum through July 2015. Videofreex are represented by <a href=\"http://www.vdb.org/\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">Video Data Bank</a> in Chicago.</p><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\"><a href=\"http://videofreex.com/\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">http://videofreex.com/</a></p></div>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"34","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Wave Farm WGXC 90.7-FM","title":"Show 0526: Videofreex by Videofreex (Wave Farm WGXC 90.7-FM)","publicdate":"2016-11-05 08:07:46","uploader":"radia.fm@gmail.com","addeddate":"2016-11-05 08:07:46","creator":"Wave Farm WGXC 90.7-FM","date":"2015-04-27","backup_location":"ia906300_11"},"server":"ia903207.us.archive.org","uniq":1602688251,"workable_servers":["ia903207.us.archive.org","ia803207.us.archive.org"]}