d8","crc32":"0bfd27ef","sha1":"a293900ef16659cd1790ee34c9d71bcb4e93a453"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1653149630","size":"3238","md5":"1a97bd5d8ad5851e9442e12f24b72b7c","crc32":"7e82d559","sha1":"4e7d504e772d0d3aee878e29ed6eb84ebb0e70a1","format":"Item Tile","rotation":"0"}],"files_count":7,"item_last_updated":1653221979,"item_size":113813393,"metadata":{"identifier":"PopulationEnvironmentAndTheMillenniumAllianceForHumanityAndThe","title":"Population, Environment, and the Millennium Alliance for Humanity and the Biosphere.","creator":"Ian Woolf","mediatype":"audio","collection":["diffusionscienceradio","podcasts"],"description":"Professor Paul Ehrlich from Stanford University spoke at the University of New South Wales on 31st October 2011 to give the Jack Beale Lecture on Population and the Environment:\n\nIn this exciting lecture Professor Ehrlich will focus on four basic points. First that Homo sapiens is a small group animal, genetically and culturally attuned to existing with 50-150 other people, now trying to live in a group of seven billion. Secondly that the planet is vastly overpopulated, possibly as much as four times the long term carrying capacity. Thirdly his belief that one of the most dangerous myths to infect civilisation is that population and economic growth have no limits and that this myth is symbolic of the failure of education systems and the mass media; and finally the idea that incremental change will save us is comforting but dangerous.","subject":"Hereswhy; population; Paul Ehrlich; exponential; non-linear; growth; environment","addeddate":"2011-11-01 04:31:54","uploader":"science@diffusionradio.com","updatedate":"2011-11-01 04:55:05","updater":"iwoolf","publicdate":"2011-11-01 04:55:06","curation":"[curator]malware@archive.org[/curator][date]20140323164056[/date][comment]checked for malware[/comment]","backup_location":"ia903705_2","external_metadata_update":"2019-03-29T06:55:27Z"},"server":"ia800104.us.archive.org","uniq":902817008,"workable_servers":["ia800104.us.archive.org","ia600104.us.archive.org"]}