_thumb.jpg","source":"original","mtime":"1541490312","size":"13192","md5":"4f98fb60b298466570cadd097840fa99","crc32":"ca33e253","sha1":"7938e9b86fbc37d43a66ebf44348086cf3baf0ce","format":"Item Tile","rotation":"0"}],"files_count":21,"item_last_updated":1541490325,"item_size":1648760724,"metadata":{"identifier":"Duke_Ellington_Tape_84_1962_Storyville_Masters_Vol._6_SAJA_Vol._7_With_Coleman_Hawkins","date":"&.7&","description":"From the David W. Niven Collection of Jazz History, a cassette recording from the Jazz artist Duke Ellington, from the era of 1962. Tape 84. <p>Recorded with a TEAC AD-500 cassette deck, a desktop computer with a modern SoundBlaster sound card, and the audio recording program GoldWave.  Each cassette was recorded to a single WAV-format file at 44100 kHz, 16-bit quality, to match the quality of CD-audio. Each resulting WAV file was split at the division between Side A and Side B of the cassette, in order to make it possible for each WAV file to fit on a single 80-minute CD.</p>","language":"eng","mediatype":"audio","title":"Niven Jazz Collection: Duke Ellington Tape 84 (1962)","collection":"davidwnivenjazz","publicdate":"2013-05-29 18:09:27","uploader":"jscott@archive.org","addeddate":"2013-05-29 18:09:27","boxid":"OL100020605","backup_location":"ia905701_16"},"server":"ia801909.us.archive.org","uniq":600435133,"workable_servers":["ia801909.us.archive.org","ia601909.us.archive.org"]}