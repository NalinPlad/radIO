hs_innerbodyradio_20141027.ogg","source":"derivative","format":"Ogg Vorbis","original":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027.mp3","mtime":"1478433058","size":"18141851","md5":"d527ee921712e1308326f02d7b93f558","crc32":"f9f53b7b","sha1":"31df719b8e06492273dcf4e9edb71b3af6270ad1","length":"1675.05","height":"0","width":"0"},{"name":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027.png","source":"derivative","format":"PNG","original":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027.mp3","mtime":"1478433100","size":"10308","md5":"a9ccdaed09e12822bb8bbd64d41fd977","crc32":"9dec1de5","sha1":"f1a4371cb0f35c7eb2e7b403f0810e18a2bc3223"},{"name":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027_archive.torrent","source":"metadata","btih":"a109f11a9b5a67db02bc071bf095f5319878e226","mtime":"1552453694","size":"5120","md5":"6c798a0c91ee93bf6cbeaa1b9fbbeb60","crc32":"db8156bb","sha1":"ec4c994ccad94418467f2abffbab3edeec7000bf","format":"Archive BitTorrent"},{"name":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027_files.xml","source":"original","format":"Metadata","md5":"4a7f2eddf8466be2d4a90a3c04fb6189","summation":"md5"},{"name":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027_meta.sqlite","source":"original","mtime":"1492337236","size":"38912","format":"Metadata","md5":"9763cb7152ddd7f0c8cd618da306937d","crc32":"f5018ec9","sha1":"6fd82fe8fead6e71088d1ff5c4fa78f72c32b18b"},{"name":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027_meta.xml","source":"original","mtime":"1699599611","size":"5220","format":"Metadata","md5":"1c301d4c3df68b3a85df75150d02f048","crc32":"ed3f5c49","sha1":"25c97387c78f572bdf72f08f53a7ef0575192e31"}],"files_count":11,"item_last_updated":1699599611,"item_size":45303413,"metadata":{"identifier":"radia_s33_n501_WaveFarm_WGXC_WilliamBurroughs_innerbodyradio_20141027","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"creator":"Wave Farm WGXC 90.7-FM","date":"2014-11-03","description":"<h1 class=\"entry-title\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:0px;vertical-align:baseline;clear:both;font-weight:normal;font-family:DaysRegular;color:rgb(210,143,0);line-height:1.3em;font-size:21px;\">Show 501: William Burroughs and Body Broadcasting (Wave Farm/WGXC)</h1><div class=\"entry-meta\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:0px;vertical-align:baseline;font-family:'Helvetica Neue', Arial, Helvetica, 'Nimbus Sans L', sans-serif;color:rgb(119,119,119);font-size:12px;\"><span class=\"meta-prep meta-prep-author\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">Posted on</span> <a href=\"http://www.radia.fm/?p=3333\" title=\"5:16 am\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(119,119,119);\" rel=\"nofollow\"><span class=\"entry-date\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">2014/11/03</span></a> <span class=\"meta-sep\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\">by</span> <span class=\"author vcard\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;\"><a class=\"url fn n\" href=\"http://www.radia.fm/?author=28\" title=\"View all posts by tom\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(119,119,119);\" rel=\"nofollow\">tom</a></span></div><div class=\"entry-content\" style=\"background:rgb(255,255,255);border:0px;margin:0px;padding:12px 0px 0px;vertical-align:baseline;clear:both;color:rgb(51,51,51);font-family:Georgia, 'Bitstream Charter', serif;font-size:13.8px;\"><p style=\"background:transparent;border:0px;margin:0px 0px 24px;padding:0px;vertical-align:baseline;\">American novelist, short story writer, essayist, painter, and spoken word performer <a href=\"http://en.wikipedia.org/wiki/William_S._Burroughs\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">William S. Burroughs</a> is sonically explored in this episode. Born 100 years ago and died in 1997, Burroughs’ cut-up period — the mid-1950s to mid-1960s — is explored here, with a special focus on Burroughs use of bodies and diseases as transmission metaphors. <a href=\"http://www.enotes.com/topics/williams-burroughs/critical-essays/burroughs-william-s-eward-1914-1\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">Ronald De Feo wrote in Modern Occasions in 1972</a>, “in ‘The Ticket that Exploded,’ he scatters among his short-winded and repetitive fantasies a metaphysics, an eschatology, a theory of possession by demonic tape recorders, a theory of sexuality, an assault on advertising as a form of brainwashing, the usual quota of flashbulb-and-firecracker sodomies, and some suggestions for mind-changing party games.” This show cuts-up Burroughs’ words and mixes them with other odd sounds and stories. Two in particular about the body as transmitter or receiver. The episode samples Lucille Ball, talking about her molar radio, and an episode of the 1960s American television show “Gilligan’s Island” in which the title character’s tooth becomes a radio receiver. Then radio artist Anna Friz talks about whale radio, and other sonic signals sent by underwater creatures, from a talk in Toronto, Canada at the “Trans-X Transmission Art Symposium.” Burroughs words on disease, bodies, and transmission are cut-up throughout the show. Produced by Tom Roe from <a href=\"http://wavefarm.org/\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">Wave Farm</a> and <a href=\"http://www.wgxc.org/\" style=\"background:transparent;border:0px;margin:0px;padding:0px;vertical-align:baseline;color:rgb(116,51,153);\" rel=\"nofollow\">WGXC</a> in New York, in the United States.</p></div>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"33","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Wave Farm WGXC 90.7-FM","title":"Show 0501: William Burroughs and Body Broadcasting by Tom Roe (Wave Farm WGXC 90.7-FM)","publicdate":"2016-11-06 11:49:26","uploader":"radia.fm@gmail.com","addeddate":"2016-11-06 11:49:26","backup_location":"ia906300_13","external_metadata_update":"2019-03-13T05:08:01Z"},"server":"ia800508.us.archive.org","uniq":1839078340,"workable_servers":["ia800508.us.archive.org","ia600508.us.archive.org"]}