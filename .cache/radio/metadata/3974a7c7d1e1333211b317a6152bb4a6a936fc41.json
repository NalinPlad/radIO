58b89e85","sha1":"ae83511f632d923165511cab1250f946dce8210a","length":"1680.09","height":"0","width":"0"},{"name":"radia_s27_n355_Radio_Helsinki_life-and-death-of-arissat-1.png","source":"derivative","format":"PNG","original":"radia_s27_n355_Radio_Helsinki_life-and-death-of-arissat-1.mp3","mtime":"1493703855","size":"10749","md5":"ecff4aae6dd9012d79f8c7e7d5de989e","crc32":"32cf49c3","sha1":"6b09b9adeeaa449daa38967b1e3dd5394f3263fe"},{"name":"radia_s27_n355_Radio_Helsinki_life-and-death-of-arissat-1_archive.torrent","source":"metadata","btih":"127f72132ba2b5dd12067f46e40da97248edf80c","mtime":"1552408073","size":"5967","md5":"aff92dbab132ee01b6ed5f729a0f4d13","crc32":"82756fc5","sha1":"30e3a4695b8dcbbe7d5fabdd254e2739a89d06ad","format":"Archive BitTorrent"},{"name":"radia_s27_n355_Radio_Helsinki_life-and-death-of-arissat-1_files.xml","source":"original","format":"Metadata","md5":"7be67bbe3124f6c5f2db24dcfc82a009","summation":"md5"},{"name":"radia_s27_n355_Radio_Helsinki_life-and-death-of-arissat-1_meta.sqlite","source":"original","mtime":"1493703727","size":"18432","format":"Metadata","md5":"914292a7a2e4d602a597b4f9f93be1ae","crc32":"fcfa69f8","sha1":"82763c0a59b400cb5d29ef91bb5216ea82797f55"},{"name":"radia_s27_n355_Radio_Helsinki_life-and-death-of-arissat-1_meta.xml","source":"original","mtime":"1665976904","size":"2297","format":"Metadata","md5":"0114c51606800238f91cd33cba5ca736","crc32":"a39eeac6","sha1":"e3d1d5cb1f2c0b64e67d9a26a2b87623e775e21c"}],"files_count":11,"item_last_updated":1665976904,"item_size":71347765,"metadata":{"identifier":"radia_s27_n355_Radio_Helsinki_life-and-death-of-arissat-1","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"On August 3rd, 2011, Arissat-1 was launched directly from the ISS, \nthe International Space Station. NASA TV broadcast this life over the \ninternet, and thousands of people worldwide watched the deployment, and \nafter that followed the first amateur radio satellite launched from a \nvehicle in space. After only a short life time, Arissat-1 was heard for \nthe last time on Jan, 4th 2011. As we are going to undergo a similar \nprocedure with mursat1, regarding a shortlife time, and very short and \nquick passes over head, Arissat-1 was a good way to learn about \nsatellite spotting.\n<p>Recordings used: deployment, recorded at ESC im LABOR on Aug 3rd; \nArissat signals received at the amateur radio groundstation, Graz, in \nAugust 2011; coallision – a realtime audio visual installation by Jogi \nHofmüller, a sonification of debris parts from a coallision from 2 \nsatellites in 2009, and Juri by Peter Venus (both shown at ESC during \nsteirischer herbst 2011), Raumsonde Venus-Wega, Performance by Peter \nVenus and Marian Weger at musikprotokoll 2011, Windsong by Reni \nHofmüller, at musikprotokoll 2011; excerpts of KraftiM – Criguere, found\n on Jamendo.</p>\n<p>You can find more about the space art project mur.sat at<a href=\"http://sat.mur.at/\" rel=\"nofollow\"> http://sat.mur.at/</a></p>","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"27","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Radio Helsinki","title":"Show 0355: Life and Death of Arissat-1 by Reni Hofmüller (Radio Helsinki)","publicdate":"2017-05-02 05:39:00","uploader":"radia.fm@gmail.com","addeddate":"2017-05-02 05:39:00","date":"2012-01-16","creator":"Radio Helsinki","backup_location":"ia906403_13","external_metadata_update":"2019-03-12T16:27:36Z"},"server":"ia601500.us.archive.org","uniq":99003530,"workable_servers":["ia601500.us.archive.org","ia801500.us.archive.org"]}