":"76fe4a0a066127b01698a611d0dc73ca6a9a3a52"},{"name":"Radio1RapShow-19960127_archive.torrent","source":"metadata","btih":"a8129415b5e2ffd693d1d0fe80f1f8a537c30384","mtime":"1595896597","size":"24178","md5":"1ff63d005d4151ebd07ab3bc5d56e23a","crc32":"15fdc52b","sha1":"7a4c6871b4d5bc06b0a35cbae1631b972dccab9b","format":"Archive BitTorrent"},{"name":"Radio1RapShow-19960127_files.xml","source":"original","format":"Metadata","md5":"c7b261018e8c293a0713f47b2c001b9e","summation":"md5"},{"name":"Radio1RapShow-19960127_meta.sqlite","source":"original","mtime":"1544314626","size":"17408","md5":"a3e738141de273be8cb0e25cc8c3c43b","crc32":"50c1cf00","sha1":"004010f928f93e5f64710ba831dfd86ce86f911a","format":"Metadata"},{"name":"Radio1RapShow-19960127_meta.xml","source":"original","mtime":"1732276475","size":"2603","format":"Metadata","md5":"a08eec7bd02f47e41922e150843e197e","crc32":"d38db9bf","sha1":"c9d63f041f8af6f407f01e4e5b98f5748f94dec3"},{"name":"_HOUR_00_Radio 1 Rap Show 27.01.96 (Anniversary show - Flex).afpk","source":"derivative","format":"Columbia Peaks","original":"Radio 1 Rap Show 27.01.96 (Anniversary show - Flex).mp3","mtime":"1544315584","size":"770720","md5":"92525562cd1432ce3e9b26b2691a736e","crc32":"cf712894","sha1":"19c7373d3224df55bafafd580f6f8e089c2e5ef1"},{"name":"_HOUR_01_Radio 1 Rap Show 27.01.96 (Anniversary show - Flex).afpk","source":"derivative","format":"Columbia Peaks","original":"Radio 1 Rap Show 27.01.96 (Anniversary show - Flex).mp3","mtime":"1544315614","size":"810320","md5":"63567295065a62b1acf0f2354eb04c47","crc32":"0dea5a55","sha1":"22e590bb3eb6375c397cf95279f49acd1c99dfed"},{"name":"_HOUR_02_Radio 1 Rap Show 27.01.96 (Anniversary show - Flex).afpk","source":"derivative","format":"Columbia Peaks","original":"Radio 1 Rap Show 27.01.96 (Anniversary show - Flex).mp3","mtime":"1544315642","size":"666272","md5":"2b0a28dc6af56cf02eb910731a0f9fd6","crc32":"80ece3a7","sha1":"aba39227324d911cdf73b63090c81008c72ead71"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1544315720","size":"2289","md5":"f8dbe60a324eeb6d1d9f6d0b9cddd90a","crc32":"8420e7cd","sha1":"a45b9a32d553a13e9cffcacd432d665f7492d7f1","format":"Item Tile","rotation":"0"}],"files_count":13,"item_last_updated":1732276475,"item_size":544149647,"metadata":{"identifier":"Radio1RapShow-19960127","mediatype":"audio","collection":["hiphopradioarchive","radioprograms"],"creator":"Tim Westwood & Funkmaster Flex","date":"1996-01-27","description":"<div>This was a bit of a big deal at the time. Previously the Rap Exchange shows had given us 2 hours a month of Flex's show in NYC but this time he'd come to the UK to (relentlessly) promote his first 60 Minutes Of Funk mixtape and play at Club UN for the 1st anniversary of Tim's Radio 1 show, which started in December 94. What we got was two 3 hour shows of Flex mixing interspersed with Akinyele and Sadat X freestyles as they'd accompanied him on the trip, having featured on the mixtape's lead single Loud Hangover. I've posted some bits of these recordings years ago but thought I'd better throw the whole 6 hours up before the blog is done.</div><div><br /></div><div>I remember being at home with a really shitty cold listening to this live on both nights (often I'd record and listen back the next day) and I'm pretty sure this was the first time I heard California Love and Woo Hah. I also wrote down the entire tracklist at the time but can't quite bring myself to type it up yet.Suffice to say that with that much time to do his thing, Flex runs through pretty much everything. Alongside the new music there's golden era classics, breakbeats and some R&B.</div><div><br /></div><div>- DJ Step One</div>","language":"eng","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":["hip-hop","radio","london"],"title":"Radio 1 Rap Show: January 27, 1996 (Anniversary Show)","publicdate":"2018-12-09 00:16:43","uploader":"rmacmich@gmail.com","addeddate":"2018-12-09 00:16:43","hhra_title":"Radio 1 Rap Show","hhra_callletters":"BBC Radio 1","hhra_stationfreq":"97-99 FM","hhra_location":"London, England, UK","hhra_djshosts":"Tim Westwood","hhra_featuring":"Funkmaster Flex, Sadat X, Akinyele","hhra_credit":"DJ Step One","hhra_sourceurl":"https://djstepone.blogspot.com/2018/12/radio-1-rap-show-1st-anniversary-with.html","external_metadata_update":"2019-04-01T07:29:38Z","backup_location":"ia906805_5"},"server":"ia800501.us.archive.org","uniq":1686455917,"workable_servers":["ia800501.us.archive.org","ia600501.us.archive.org"]}