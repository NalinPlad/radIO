77233a570ed34beadafa401452","crc32":"f4444052","sha1":"98339999efb0e966e2ecf0d0d52470e74aa7d8b7","format":"PNG"},{"name":"TSTBD_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"TSTBD.png","mtime":"1678897132","size":"6537","md5":"ed02559975f4415756b0c310432e4356","crc32":"c166d739","sha1":"b5358b213c37a7f144548a749ac72e8abbc546a0"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1678897018","size":"11762","md5":"c365d8b789af873581fe86c9915004e5","crc32":"0d2d22b9","sha1":"a17622029073ac79acb467c17cc00e4da6b5eabb","format":"Item Tile","rotation":"0"},{"name":"radia-s-50-n-939-soundart-radio-tst-bd-wav_archive.torrent","source":"metadata","btih":"ef0b11b91be5dfa923d0afc400274afa911f7661","mtime":"1714983834","size":"42044","md5":"c70b720c38e27cc6a902fd2031629337","crc32":"4bc986ae","sha1":"46bdd81234a910dadfd7a7dceedd9c6f47fb718d","format":"Archive BitTorrent"},{"name":"radia-s-50-n-939-soundart-radio-tst-bd-wav_files.xml","source":"original","format":"Metadata","md5":"ee6e40dea7d1427f982b275e4f039ab2","summation":"md5"},{"name":"radia-s-50-n-939-soundart-radio-tst-bd-wav_meta.sqlite","source":"original","mtime":"1678897009","size":"45056","md5":"5cb89b2932a8bae8205d4c8472823f00","crc32":"c8747473","sha1":"c461589ae4f6345d0132abd2e06d275b70374596","format":"Metadata"},{"name":"radia-s-50-n-939-soundart-radio-tst-bd-wav_meta.xml","source":"original","mtime":"1714983829","size":"2613","md5":"7a8f517aa8d306fc6cbd701e1c072149","crc32":"36bee3b1","sha1":"3203b63136e4276286bd0798e6638c2085b7effe","format":"Metadata"}],"files_count":25,"item_last_updated":1714983834,"item_size":950072378,"metadata":{"identifier":"radia-s-50-n-939-soundart-radio-tst-bd-wav","mediatype":"audio","collection":["radiafm","radiostationarchives","radioprograms"],"creator":"Soundart Radio","date":"2023-03-27","description":"\"TstBd\" was a ritual performance carried out December 9th 2021 in Studio 1, Dartington Hall. Utilizing sound, radio feedback, video &amp; ritual a spell was cast, the results of which are as yet indeterminate. <div><br /><div><div>The Test Bed was a performance created in response to a critical investigation into Dartington Hall, its history, pedagogical legacy and the landscape and people who live and have lived in and around the estate. The title was taken from a board annual report for the Dartington Trust in which it was stated \"Dartington should be a test bed for a just and sustainable future\" Indeed, the sigil used ritually in this piece is conceived from this premise. The work is a celebration of craftmanship, egalitarianism, the landscape of Dartington Hall and a call to remember its history as a catalyst for experimentation and exploration of radical ideas. </div><div>\"It brought to mind fluxus performances from the 60’s and seemed</div><div>to symbolize a revisiting of Dartington’s history although the involvement of radios in the space</div><div>and the knowledge that this was being broadcast on Soundart radio brought the focus into the</div><div>present. An experimental practice-based project which was professional, engaging and displayed a rigorous performative approach and inventive use of research material.\" - Dr Jo Joelson (London Fieldworks)</div><div><br /></div><div>The audio is also available in conjunction with the video footage from the performance here - <a href=\"https://www.youtube.com/watch?v=XPtn2tTEkAc\" rel=\"nofollow\">The Test Bed - YouTube</a> </div></div></div>","language":"eng","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","scanner":"Internet Archive HTML5 Uploader 1.7.0","subject":"radio art;Radia;Soundart Radio","title":"Show 0939: TstBd by Christopher Booth (Soundart Radio)","uploader":"radia.fm@gmail.com","publicdate":"2023-03-15 16:11:53","addeddate":"2023-03-15 16:11:53","year":"2023","radiaseason":"50"},"server":"ia801602.us.archive.org","uniq":216008847,"workable_servers":["ia801602.us.archive.org","ia601602.us.archive.org"]}