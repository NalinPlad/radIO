d1507d557b99","crc32":"b8a36725","sha1":"32e2129621caf30a85227297b04e6c5ff06dcc71","format":"Metadata"},{"name":"jfks19611116_vbr.m3u","source":"derivative","format":"VBR M3U","original":"jfk_1961_1116_universityofwashington_vbr.mp3","md5":"201ed31922f40ac446b6d04aadfb5378","mtime":"1085012565","size":"90","crc32":"ed929e8d","sha1":"eaaedb4e32730fb646bf824806ba05b1deb33c1e"},{"name":"jfks19611116_vbr_mp3.zip","source":"derivative","format":"VBR ZIP","original":"jfk_1961_1116_universityofwashington_vbr.mp3","md5":"9045f5bbfb16536be5fa2338854742a5","mtime":"1085012595","size":"16669093","crc32":"1950c702","sha1":"764a875a1ce65b53307819675458a36f071bac44","length":"1037.51","height":"0","width":"0","filecount":"1"}],"files_count":21,"item_last_updated":1547526914,"item_size":260420853,"metadata":{"mediatype":"audio","identifier":"jfks19611116","type":"sound","publicdate":"2004-05-19 18:23:32","creator":"John F. Kennedy","description":"Address in Seattle at the University of Washington's 100th Anniversary Program. Edmundson Pavilion, Seattle, WA. ","date":"1961-11-16 00:00:00","collection":["presidential_recordings","audio_news"],"title":"John F. Kennedy Speech, November 16, 1961","uploader":"michaeldgreco@hotmail.com","addeddate":"2004-05-19 17:04:04","adder":"1fingerwillie","pick":"0","runtime":"17:22","updatedate":"2004-05-20 06:44:10","updater":"1fingerwillie","notes":"A digital copy of this White House recording has been provided by the Miller Center of Public Affairs. For more information on this and other recordings, visit the Miller Center's <a href=\"http://www.millercenter.virginia.edu/scripps/index.html\" rel=\"nofollow\">Scripps Library</a>.","source":"John F. Kennedy Presidential Library","taper":"White House","subject":"John F. Kennedy","publisher":"White House","numeric_id":"5186","boxid":"OL100020301","backup_location":"ia903600_5"},"reviews":[{"review_id":"39955","reviewbody":"A very interesting speech, one of the better ones JFK gave, that talks about even though the US is a big superpower, how we shouldnt take the power for granted, after all, they are a nation among many, the population is only like 12% of the world. It's sort of interesting to hear that compared to todays \"take it or we'll bomb ya\" approach the Bush admin seems to take..","reviewtitle":"Bush should be proud..","reviewer":"Spuzz","reviewdate":"2005-04-28 13:15:13","createdate":"2005-04-28 13:15:13","stars":"4"},{"review_id":"41832","reviewbody":"Are we a nation? a republic? A group of of pacifists who have laid down our  bodies only to let the Bush and Co. ruin this country?  Wake up America.. I am sick, sick and tired of these bastards.                                                                                    I feel helpless, somebody please bring back Jack.\n\nps: check out Media Burn","reviewtitle":"WOW","reviewer":"toenailtips","reviewdate":"2005-05-21 08:28:55","createdate":"2005-05-21 08:28:55","stars":"5"},{"reviewbody":"This is the one where he says we are only 6% of the world population and therefore there cannot be an American solution to every world problem.  He talks about diplomacy and the use of force and how either alone would fail, and the importance of negotiations in resolving problems.  It is typical Kennedy - practical, reasonable and sensible.  Compare that to the stubborn idealism of our current President and you begin to long for the good old days.  ","reviewtitle":"Very interesting.","stars":"5","reviewer":"hwunyee","createdate":"2006-10-30 09:13:16","reviewdate":"2006-10-30 09:13:16"}],"server":"ia800208.us.archive.org","uniq":651557678,"workable_servers":["ia800208.us.archive.org","ia600208.us.archive.org"]}