":"derivative","format":"PNG","original":"radia_s11_n102_soundart_Floors.mp3","mtime":"1493324834","size":"10615","md5":"11a813440f227a3a4d0a4bb1e6f31996","crc32":"eda95069","sha1":"e09dfe22285ad4b551db0ee699b18e441aa5baa2"},{"name":"radia_s11_n102_soundart_Floors_archive.torrent","source":"metadata","btih":"18327895752a07eae142f82ff2f15f2eeeb1a45e","mtime":"1554400263","size":"6196","md5":"0ac4c2c6a5d41db2161fae4720ac38fd","crc32":"9991e8ea","sha1":"0c6cacb7e02f956e88333bbf07b9ca0ab2f70f15","format":"Archive BitTorrent"},{"name":"radia_s11_n102_soundart_Floors_files.xml","source":"original","format":"Metadata","md5":"d28633a4b281fc2874addabd0850d958","summation":"md5"},{"name":"radia_s11_n102_soundart_Floors_meta.sqlite","source":"original","mtime":"1493324716","size":"14336","format":"Metadata","md5":"b6727e70ebeb9fd2ae7d743730ae0370","crc32":"6e70732a","sha1":"c96796e29517c2123090293ea87ef1084b99a3c0"},{"name":"radia_s11_n102_soundart_Floors_meta.xml","source":"original","mtime":"1669312970","size":"1642","format":"Metadata","md5":"6c243b59819a86eea49b8f3bcb905f16","crc32":"729a2c7f","sha1":"b9659d89e5efcf18191431509f9fdb9584202b67"}],"files_count":11,"item_last_updated":1669312970,"item_size":86815853,"metadata":{"identifier":"radia_s11_n102_soundart_Floors","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"Produced by Lucinda Guy and Alexander Paterson.<br />\n“Originally we thought about doing a dance/movement piece for radio, but\n  as we worked we became more interested in the variety of sounds the  \nfloors here make. Some of the studios we recorded in have been here for \n decades, as part of Dartington College of Arts which was formed in \n1961.  The college is now to be closed down, or move 80 miles to merge \nwith a  larger institution. It’s the smallest academic institution in \nEngland  and is no longer considered viable. This piece is a homage to \nthe floors  of Dartington with their unique creaks and squeaks, and to a\n college  which could not be replicated anywhere else.”","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","radiaseason":"11","scanner":"Internet Archive HTML5 Uploader 1.6.3","subject":"radio art;Radia;Soundart Radio","title":"Show 0102: Floors We Have Known by Lucinda Guy, Alexander Paterson (Soundart Radio)","publicdate":"2017-04-27 20:20:22","uploader":"radia.fm@gmail.com","addeddate":"2017-04-27 20:20:22","creator":"Soundart Radio","date":"2007-03-12","backup_location":"ia906403_3","external_metadata_update":"2019-04-04T17:50:44Z"},"server":"ia800109.us.archive.org","uniq":573366692,"workable_servers":["ia800109.us.archive.org","ia600109.us.archive.org"]}