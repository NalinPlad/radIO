b8e6e542b4b246e3a","crc32":"9bb54a9b","sha1":"f2bb9414bf8d5d6b349fa26eeee025c7e0e0fc64","format":"Metadata"},{"name":"Scott_Hamilton_Tape_3A_1980-1981_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"Scott_Hamilton_Tape_3A_1980-1981.jpg","mtime":"1369870515","size":"9816","md5":"2c8b34a6087e32e6e2927817bb927257","crc32":"43292395","sha1":"0aac584cd6e38fb0f4b1a2893df5722804c99663"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1742988519","size":"18154","md5":"1396546bc8d72704055052440113e325","crc32":"c6ebd44f","sha1":"53f94848d21a8f9c251bf55a8a0406c3ba660b52","format":"Item Tile","rotation":"0"}],"files_count":22,"item_last_updated":1742988528,"item_size":1793187860,"metadata":{"identifier":"Scott_Hamilton_Tape_3A_1980-1981","date":"1981","description":"From the David W. Niven Collection of Jazz History, a cassette recording from the Jazz artist Scott Hamilton, from the era of 1980-1981. Tape 3A. <p>Recorded with a TEAC AD-500 cassette deck, a desktop computer with a modern SoundBlaster sound card, and the audio recording program GoldWave.  Each cassette was recorded to a single WAV-format file at 44100 kHz, 16-bit quality, to match the quality of CD-audio. Each resulting WAV file was split at the division between Side A and Side B of the cassette, in order to make it possible for each WAV file to fit on a single 80-minute CD.</p>","language":"eng","mediatype":"audio","title":"Niven Jazz Collection: Scott Hamilton Tape 3A (1980-1981)","collection":"davidwnivenjazz","publicdate":"2013-05-29 23:34:32","uploader":"jscott@archive.org","addeddate":"2013-05-29 23:34:32","boxid":"OL100020606","backup_location":"ia905701_17"},"reviews":[{"reviewtitle":"Great Jazz Mix Tapes","reviewbody":"Scott Hamilton from the late 70s and early 80s on Concord.  Nice stuff and sounds well recorded! \n\nUncle Joe's Jazz Tunz!","stars":"5","reviewer":"uncle joe&apos;s tunz","reviewdate":"2025-03-26 11:28:31","createdate":"2025-03-26 11:28:31","reviewer_itemname":"@