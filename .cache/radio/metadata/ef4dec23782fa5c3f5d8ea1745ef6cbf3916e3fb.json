arius Ciuta.flac","mtime":"1735463174","size":"46692327","md5":"4ef31211a714a4145ed3b96049427c97","crc32":"327ebf3e","sha1":"37c84c683395df849244f0686556e752542ac007"},{"name":"show 1032t IUrDi by Darius Ciuta.png","source":"derivative","format":"PNG","original":"show 1032t IUrDi by Darius Ciuta.flac","mtime":"1735463206","size":"39703","md5":"6a18a1d62ff022748b2dacbca238ba7d","crc32":"7f87072d","sha1":"c558c4e7ac3c63282213fe11830da3d8d0244cab"},{"name":"show 1032t IUrDi by Darius Ciuta_spectrogram.png","source":"derivative","format":"Spectrogram","original":"show 1032t IUrDi by Darius Ciuta.flac","mtime":"1735463224","size":"313692","md5":"d45314015d46280eab6d79e4e6477637","crc32":"21ab6dc5","sha1":"a277f78e38878d4abc27873757489c99f76587b0"},{"name":"show-1032t-iur-di-by-darius-ciuta_archive.torrent","source":"metadata","btih":"7389d41135c5435955466a450a86c99de2edc89d","mtime":"1735463274","size":"12243","md5":"7e140d58e58fcf312c3920b0b8005f80","crc32":"bdcc4b4b","sha1":"fb219f174c6a479c5f1fd56c482ea0b01369ae45","format":"Archive BitTorrent"},{"name":"show-1032t-iur-di-by-darius-ciuta_files.xml","source":"original","format":"Metadata","md5":"e46823ac6fd767fc62a25f11014660eb","summation":"md5"},{"name":"show-1032t-iur-di-by-darius-ciuta_meta.sqlite","source":"original","mtime":"1735463052","size":"49152","md5":"cebdcfc26b9ffd0ba7d207013dc612ac","crc32":"23eb0ca3","sha1":"6cdbb4ff9cdac2887fc47a684d17f1c362759516","format":"Metadata"},{"name":"show-1032t-iur-di-by-darius-ciuta_meta.xml","source":"original","mtime":"1735463264","size":"4436","md5":"8c873f150594ef756c1104a0ed306192","crc32":"b755c151","sha1":"54c30c2a2f7581885946b9e509f59bfe4ff1d435","format":"Metadata"}],"files_count":14,"item_last_updated":1735463274,"item_size":229623521,"metadata":{"identifier":"show-1032t-iur-di-by-darius-ciuta","mediatype":"audio","collection":["radiafm","radiostationarchives","radioprograms"],"creator":"radio zero","date":"2024-12-29","description":"<p style=\"font-size:16px;border:0px;font-family:Lato, sans-serif;margin:0px 0px 24px;padding:0px;vertical-align:baseline;color:rgb(43,43,43);background-color:rgb(255,255,255);\">surround texture as text.</p><p style=\"font-size:16px;border:0px;font-family:Lato, sans-serif;margin:0px 0px 24px;padding:0px;vertical-align:baseline;color:rgb(43,43,43);background-color:rgb(255,255,255);\">Radio work recorded, composed and mastered by  Darius Čiuta in Kaunas Lithuania. Further demixed redux by Paulo Raposo in Lisbon</p><p style=\"font-size:16px;border:0px;font-family:Lato, sans-serif;margin:0px 0px 24px;padding:0px;vertical-align:baseline;color:rgb(43,43,43);background-color:rgb(255,255,255);\">Darius Čiuta, Lithuanian architect, sound artist, born 1966, is an artist that definitely can not be pigeonholed for the marketing purposes of narrative and aesthetic unidirectional coherence, although if you stand between and shuffle through his work you will find a labyrinth of communicating vessels. His works explore continuously new alphabets spectrums, building an intricate vocabulary of frequencies and densities as translations and transformations (exchange between sound and spaces). Structured architectural approaches with a clear perspective not only invites to what is beyond stritctly personal music but rather emtwines a evershifting method of researching a singular plunge into sound itself.</p><p style=\"font-size:16px;border:0px;font-family:Lato, sans-serif;margin:0px 0px 24px;padding:0px;vertical-align:baseline;color:rgb(43,43,43);background-color:rgb(255,255,255);\">He self-released many cassettes in Lithuania during the 1990s under the Naj moniker, and was included in the ‘500 Lock Grooves by Artists’ LP on RRR in 1998. While Čiuta is known for his noise music during the 1990s, he turned to a very particular electro-acoustic music later on, exploring approaches to musique concrète made from found objects, radio, turntable, tapes and found sounds.</p><p style=\"font-size:16px;border:0px;font-family:Lato, sans-serif;margin:0px 0px 24px;padding:0px;vertical-align:baseline;color:rgb(43,43,43);background-color:rgb(255,255,255);\">some of his recent works can be found here on Sirr label.</p><p style=\"font-size:16px;border:0px;font-family:Lato, sans-serif;margin:0px 0px 24px;padding:0px;vertical-align:baseline;color:rgb(43,43,43);background-color:rgb(255,255,255);\"><a href=\"http://sirr-ecords.bandcamp.com/album/23-t-2\" style=\"border:0px;font-family:inherit;font-style:inherit;margin:0px;padding:0px;vertical-align:baseline;color:rgb(36,137,13);\" rel=\"nofollow\">sirr-ecords.bandcamp.com/album/23-t-2</a><br /><a href=\"http://sirr-ecords.bandcamp.com/album/tekstai-2\" style=\"border:0px;font-family:inherit;font-style:inherit;margin:0px;padding:0px;vertical-align:baseline;color:rgb(36,137,13);\" rel=\"nofollow\">sirr-ecords.bandcamp.com/album/tekstai-2</a><br /><a href=\"http://sirr-ecords.bandcamp.com/album/alt-iu-kb\" style=\"border:0px;font-family:inherit;font-style:inherit;margin:0px;padding:0px;vertical-align:baseline;color:rgb(36,137,13);\" rel=\"nofollow\">sirr-ecords.bandcamp.com/album/alt-iu-kb</a><br /><a href=\"http://sirr-ecords.bandcamp.com/album/in-the-middle-of-1234\" style=\"border:0px;font-family:inherit;font-style:inherit;margin:0px;padding:0px;vertical-align:baseline;color:rgb(36,137,13);\" rel=\"nofollow\">sirr-ecords.bandcamp.com/album/in-the-middle-of-1234</a></p>","licenseurl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","radiaseason":"54","scanner":"Internet Archive HTML5 Uploader 1.7.0","subject":"radio art;radia","title":"SHOW 1032: IURDI BY DARIUS ČIUTA (RÁDIO ZERO)","uploader":"radia.fm@gmail.com","collection_added":["radiostationarchives","radioprograms"],"publicdate":"2024-12-29 09:03:48","addeddate":"2024-12-29 09:03:48"},"server":"ia800803.us.archive.org","uniq":131120697,"workable_servers":["ia800803.us.archive.org","ia600803.us.archive.org"]}