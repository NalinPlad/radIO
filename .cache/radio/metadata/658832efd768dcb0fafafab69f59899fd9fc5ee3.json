original":"lbj_wh6607_01_10409_gonzalez_vbr.mp3","mtime":"1416347030","size":"9968","md5":"29d6302651cb3ef0067ca718d05affe9","crc32":"2a8b050e","sha1":"88f57d9058b01b91526e31fdd359656f2a5fd53b"}],"files_count":93,"item_last_updated":1547527563,"item_size":844435973,"metadata":{"mediatype":"audio","identifier":"lbj660701","type":"sound","publicdate":"2004-05-25 21:00:44","creator":"Lyndon B. Johnson","description":"Lyndon B. Johnson secret White House recording. Tape 1 of July 1966.","date":"1966-07-00 00:00:00","collection":["presidential_recordings","audio_news"],"title":"Lyndon B. Johnson Recording 6607.1; July 1966, Tape 1","uploader":"michaeldgreco@hotmail.com","addeddate":"2004-05-25 17:25:11","adder":"1fingerwillie","pick":"0","notes":"A digital copy of this White House recording has been provided by the Miller Center of Public Affairs. For more information on this and other recordings, visit the Miller Center's <a href=\"http://www.millercenter.virginia.edu/scripps/index.html\" rel=\"nofollow\">Scripps Library</a>.","source":"Lyndon B. Johnson Presidential Library","taper":"White House","subject":"Lyndon B. Johnson","publisher":"White House","numeric_id":"5432","updatedate":"2005-12-14 12:00:21","updater":"unix:etree","boxid":"OL100020310","backup_location":"ia903600_5"},"reviews":[{"review_id":"44668","reviewbody":"Great collection, except for the snooze inducing conversation with Clark about Mr. Ball. The president talks to various people about meetings he doesnt want to go to, some Viet Nam thing, Procter and Gamble, and other minor things. The big hilight here is his conversation with Harry Truman (LBJ actually starts the conversation with \"Mr. President?\"). He talks with him about Truman's aborted trip overseas and LBJ reminds Truman of his rights as an ex-president that he can have the Presidential plane any time he wanted. Nice! LBJ hands off the phone to Ladybird and one of his daughters as well, boring the old codger to death lol. Fun tape!","reviewtitle":"Can you say hello to the wife?","reviewer":"Spuzz","reviewdate":"2005-06-26 21:13:55","createdate":"2005-06-26 21:13:55","stars":"4"}],"server":"ia801304.us.archive.org","uniq":635587128,"workable_servers":["ia801304.us.archive.org","ia601304.us.archive.org"]}