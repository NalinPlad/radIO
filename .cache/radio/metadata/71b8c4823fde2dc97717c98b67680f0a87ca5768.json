147250b34e886d49f09a47293e08f8bbfbcd"},{"name":"radia_s19_n208_Kanal103_In_the_name_of_Science_192.mp3","source":"derivative","creator":"Andrej Ancevski (AHz), Martin Anastasovski","title":"In the name of Science","track":"208","album":"Radia Season 19","bitrate":"154","length":"29:59","format":"VBR MP3","original":"radia_s19_n208_Kanal103_In_the_name_of_Science_192.ogg","mtime":"1492335944","size":"34604032","md5":"d1641f9c15048c82ac6c3fca91aacc67","crc32":"3a9c3806","sha1":"eeaa3104968b2015f174d50036319f635329ee20","height":"0","width":"0"},{"name":"radia_s19_n208_Kanal103_In_the_name_of_Science_192.ogg","source":"original","size":"29167704","format":"Ogg Vorbis","title":"In the name of Science","creator":"Andrej Ancevski (AHz), Martin Anastasovski","album":"Radia Season 19","track":"208","mtime":"1285770747","md5":"417aa965b84254c2afe64442533141e6","crc32":"ce2306bb","sha1":"21290655287684e67c69d207ab35539dd0e2152b","length":"1798.99","height":"0","width":"0","external-identifier-match-date":"acoustid:2019-04-05T02:41:00Z","external-identifier":"urn:acoustid:092a9299-77b4-4926-a63a-4f5ebc1364cf"},{"name":"radia_s19_n208_Kanal103_In_the_name_of_Science_192.png","source":"derivative","format":"PNG","original":"radia_s19_n208_Kanal103_In_the_name_of_Science_192.ogg","mtime":"1492336026","size":"11966","md5":"eb93e3324499ce3654027e1326b34661","crc32":"3e11ffb8","sha1":"eb5a1e7127c09cbd02ce09b3709ca37541d171d8"},{"name":"radia_s19_n208_Kanal103_In_the_name_of_Science_192_spectrogram.png","source":"derivative","format":"Spectrogram","original":"radia_s19_n208_Kanal103_In_the_name_of_Science_192.ogg","mtime":"1492336043","size":"276592","md5":"51edca0f8978ebc888d4a8824b20eb26","crc32":"6a65f38b","sha1":"8cd7591b38ab9a3c77142c906050291beb9addb6"}],"files_count":12,"item_last_updated":1709014251,"item_size":64461123,"metadata":{"identifier":"RadiaSeason019208","title":"Show 0208: In the name of Science by Andrej Ancevski, Andreas Hz (Kanal 103)","mediatype":"audio","collection":["radiafm","radioprograms","radiostationarchives"],"description":"This is radio show # 208 of season 19 of the <a href=\"http://www.radia.fm\" rel=\"nofollow\">Radia</a> weekly comissioned radio art programs. It was submited by <a href=\"http://kanal103.com.mk\" rel=\"nofollow\">Kanal 103</a>. \n\nIt was broadcasted in all Radia stations in the week between 23.02.2009 and 29.03.2009. \n\n<a href=\"http://en.wikipedia.org/wiki/Radia\" rel=\"nofollow\">Read about Radia \non wikipedia.</a>\n\n--\n\"In the name of Science\"\n\nIn a dark and dusty basement in suburban Skopje, we have found an analogue AM radio receiver dating from 1954. Tinkering with the knobs we scanned Europe's AM airwaves and recorded the process. The first half of the show is some of the raw recording, while the second are two tracks made by experimental artists Andrej Ancevski (AHz) and Martin Anastasovski using the only the recorded samples as generated sounds, layered and run through various effects.\n\nAndrej Ancevski/Andreas Hz is an electronics engineer, music producer and everything in between. Likes to listen to radio and the world around him, tinker with machines and gadgets, play some music to nice people in clubs and sip martini when no one is looking.","subject":"radio art;Radia;Kanal 103","licenseurl":"http://creativecommons.org/licenses/by-nc-nd/3.0/","publicdate":"2010-09-29 14:32:46","addeddate":"2010-09-29 14:31:34","uploader":"radia.fm@gmail.com","updatedate":"2010-09-29 14:34:01","updater":"Radia.fm","boxid":"OL100020611","backup_location":"ia903606_20","date":"2009-03-23","radiaseason":"19","creator":"Kanal 103","external_metadata_update":"2019-04-05T02:41:00Z"},"server":"ia601306.us.archive.org","uniq":1603607882,"workable_servers":["ia601306.us.archive.org","ia801306.us.archive.org"]}